{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Cluster lease, peer, drain, ordered-relay, contention, and cross-node resume health.",
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "type": "timeseries",
      "title": "Node heartbeat age",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "max by (service_instance_id) (waddle_clustering_node_heartbeat_age_milliseconds)",
          "legendFormat": "{{service_instance_id}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 }
    },
    {
      "type": "timeseries",
      "title": "Connected peers per pod",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "max by (service_instance_id) (waddle_clustering_connected_peers)",
          "legendFormat": "{{service_instance_id}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 }
    },
    {
      "type": "timeseries",
      "title": "Claims released or abandoned on drain",
      "description": "Ships dark until #1295 completes drain-claim instrumentation rollout.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum(increase(waddle_clustering_claims_released_on_drain_total[5m]))",
          "legendFormat": "released",
          "refId": "A"
        },
        {
          "expr": "sum(increase(waddle_clustering_claims_abandoned_on_drain_total[5m]))",
          "legendFormat": "abandoned",
          "refId": "B"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 }
    },
    {
      "type": "timeseries",
      "title": "Ordered-relay acknowledgements",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum(increase(waddle_clustering_ordered_relay_acks_total[5m]))",
          "legendFormat": "acks",
          "refId": "A"
        },
        {
          "expr": "sum by (reason) (increase(waddle_clustering_ordered_relay_nacks_total[5m]))",
          "legendFormat": "nack: {{reason}}",
          "refId": "B"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 }
    },
    {
      "type": "timeseries",
      "title": "ClaimHeldByAnotherNode rate",
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "targets": [
        {
          "expr": "sum(count_over_time({service_name=\"waddle-server\"} |= \"ClaimHeldByAnotherNode\" [5m]))",
          "legendFormat": "claim contention / 5m",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 }
    },
    {
      "type": "timeseries",
      "title": "Cross-node resume events",
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "targets": [
        {
          "expr": "sum(count_over_time({service_name=\"waddle-server\"} |= \"cross-node resume\" [5m]))",
          "legendFormat": "cross-node events / 5m",
          "refId": "A"
        },
        {
          "expr": "sum(count_over_time({service_name=\"waddle-server\"} |~ \"(?i)SM resume (failed|rejected): cross-node\" [5m]))",
          "legendFormat": "failed or rejected / 5m",
          "refId": "B"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["waddle", "clustering"],
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus",
        "regex": "/-prom$/",
        "current": { "selected": true, "text": "grafanacloud-waddlesocial-prom", "value": "grafanacloud-prom" }
      },
      {
        "name": "DS_LOKI",
        "type": "datasource",
        "query": "loki",
        "regex": "/-logs$/",
        "current": { "selected": true, "text": "grafanacloud-waddlesocial-logs", "value": "grafanacloud-logs" }
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "title": "Waddle clustering",
  "uid": "waddle-clustering",
  "version": 1
}
