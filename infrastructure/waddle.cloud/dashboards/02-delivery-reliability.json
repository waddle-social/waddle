{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "End-to-end delivery health across stream management, pending delivery, push, broadcast, and resume paths.",
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "type": "timeseries",
      "title": "Stream-management evictions and pauses",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum(increase(waddle_sm_unacked_evicted_total[5m])) or vector(0)",
          "legendFormat": "unacked evicted",
          "refId": "A"
        },
        {
          "expr": "sum(increase(waddle_sm_detached_unacked_evicted_total[5m])) or vector(0)",
          "legendFormat": "detached unacked evicted",
          "refId": "B"
        },
        {
          "expr": "sum(increase(waddle_sm_send_window_pauses_total[5m])) or vector(0)",
          "legendFormat": "send-window pauses",
          "refId": "C"
        },
        {
          "expr": "sum(increase(waddle_sm_send_window_pause_timeouts_total[5m])) or vector(0)",
          "legendFormat": "pause timeouts",
          "refId": "D"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 }
    },
    {
      "type": "timeseries",
      "title": "Pending-delivery flush and claims",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum(increase(waddle_pending_flush_batches_total[5m])) or vector(0)",
          "legendFormat": "flush batches",
          "refId": "A"
        },
        {
          "expr": "sum(increase(waddle_pending_flush_rows_pushed_total[5m])) or vector(0)",
          "legendFormat": "rows pushed",
          "refId": "B"
        },
        {
          "expr": "sum(increase(waddle_pending_delivery_orphan_claims_released_total[5m])) or vector(0)",
          "legendFormat": "orphan claims released",
          "refId": "C"
        },
        {
          "expr": "sum(increase(waddle_pending_delivery_quota_exceeded_total[5m])) or vector(0)",
          "legendFormat": "quota exceeded",
          "refId": "D"
        },
        {
          "expr": "sum(increase(waddle_pending_delivery_aged_out_total[5m])) or vector(0)",
          "legendFormat": "aged out",
          "refId": "E"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 }
    },
    {
      "type": "timeseries",
      "title": "Push delivery funnel",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum(increase(waddle_push_candidate_created_total[5m])) or vector(0)",
          "legendFormat": "created",
          "refId": "A"
        },
        {
          "expr": "sum(increase(waddle_push_candidate_coalesced_total[5m])) or vector(0)",
          "legendFormat": "coalesced",
          "refId": "B"
        },
        {
          "expr": "sum(increase(waddle_push_outbox_published_total[5m])) or vector(0)",
          "legendFormat": "published",
          "refId": "C"
        },
        {
          "expr": "sum by (reason) (increase(waddle_push_outbox_retry_scheduled_total[5m]))",
          "legendFormat": "retry: {{reason}}",
          "refId": "D"
        },
        {
          "expr": "sum(increase(waddle_push_outbox_dead_lettered_total[5m])) or vector(0)",
          "legendFormat": "dead-lettered",
          "refId": "E"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 }
    },
    {
      "type": "timeseries",
      "title": "Broadcast outcomes",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum(increase(waddle_broadcast_delivered_total[5m])) or vector(0)",
          "legendFormat": "delivered",
          "refId": "A"
        },
        {
          "expr": "sum(increase(waddle_broadcast_not_connected_total[5m])) or vector(0)",
          "legendFormat": "not connected",
          "refId": "B"
        },
        {
          "expr": "sum(increase(waddle_broadcast_dropped_full_total[5m])) or vector(0)",
          "legendFormat": "dropped: full",
          "refId": "C"
        },
        {
          "expr": "sum(increase(waddle_broadcast_dropped_closed_total[5m])) or vector(0)",
          "legendFormat": "dropped: closed",
          "refId": "D"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 }
    },
    {
      "type": "timeseries",
      "title": "SM resume success vs missing cached session",
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "targets": [
        {
          "expr": "sum(count_over_time({service_name=\"waddle-server\"} |= \"SM resumed\" != \"without cached detached Session\" [5m])) or vector(0)",
          "legendFormat": "resumed",
          "refId": "A"
        },
        {
          "expr": "sum(count_over_time({service_name=\"waddle-server\"} |= \"SM resumed without cached detached Session\" [5m])) or vector(0)",
          "legendFormat": "missing cached session",
          "refId": "B"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 24 },
      "id": null,
      "panels": [],
      "title": "Ingress authority",
      "type": "row"
    },
    {
      "type": "timeseries",
      "title": "Decisions by class",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum by (class) (increase(ingress_decisions_total[5m])) or vector(0)",
          "legendFormat": "{{class}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 25 }
    },
    {
      "type": "timeseries",
      "title": "Alias outcomes",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum by (outcome) (increase(ingress_alias_outcomes_total[5m])) or vector(0)",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 25 }
    },
    {
      "type": "timeseries",
      "title": "Transaction retries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum(increase(ingress_tx_retries_total[5m])) or vector(0)",
          "legendFormat": "retries",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 33 }
    },
    {
      "type": "timeseries",
      "title": "Transaction duration p50 and p99",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(ingress_tx_duration_seconds_bucket[10m]))) or vector(0)",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(ingress_tx_duration_seconds_bucket[10m]))) or vector(0)",
          "legendFormat": "p99",
          "refId": "B"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 33 }
    },
    {
      "type": "timeseries",
      "title": "GC runs and reclaimed messages",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum by (outcome) (increase(ingress_gc_runs_total[5m])) or vector(0)",
          "legendFormat": "gc {{outcome}}",
          "refId": "A"
        },
        {
          "expr": "sum(increase(ingress_gc_reclaimed_messages_total[5m])) or vector(0)",
          "legendFormat": "reclaimed messages",
          "refId": "B"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 41 }
    },
    {
      "type": "timeseries",
      "title": "GC eligible messages, oldest eligible age, and retained referenced",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "max(cnpg_waddle_ingress_gc_eligible_messages)",
          "legendFormat": "eligible messages",
          "refId": "A"
        },
        {
          "expr": "max(cnpg_waddle_ingress_gc_oldest_eligible_age_seconds)",
          "legendFormat": "oldest eligible age",
          "refId": "B"
        },
        {
          "expr": "max(cnpg_waddle_ingress_gc_retained_referenced_messages)",
          "legendFormat": "retained referenced",
          "refId": "C"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 41 }
    },
    {
      "type": "timeseries",
      "title": "Unresolved effects by kind (1h increase)",
      "description": "Recorded intents without completion receipts remain protected from GC. #1658 adds the recovery executor. This counter measures newly observed unresolved effects, not the current backlog.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum by (kind) (increase(ingress_effects_unresolved_total[1h]))",
          "legendFormat": "{{kind}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 49 }
    },
    {
      "type": "timeseries",
      "title": "Messages by age bucket and state",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum by (age_days, state) (cnpg_waddle_ingress_messages_count)",
          "legendFormat": "{{state}} day {{age_days}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "showPoints": "never",
            "stacking": { "group": "A", "mode": "normal" }
          }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 49 }
    },
    {
      "type": "timeseries",
      "title": "Cohort by state",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum by (state) (cnpg_waddle_ingress_cohort_count)",
          "legendFormat": "{{state}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "lineWidth": 1,
            "showPoints": "never"
          }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 57 }
    },
    {
      "type": "timeseries",
      "title": "Ingress table bytes and tuples",
      "description": "All ingress tables exported by CNPG, including ingress_effect_receipts; table labels are not filtered.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "max by (table) (cnpg_waddle_ingress_table_total_bytes)",
          "legendFormat": "bytes {{table}}",
          "refId": "A"
        },
        {
          "expr": "max by (table) (cnpg_waddle_ingress_table_live_tuples)",
          "legendFormat": "live {{table}}",
          "refId": "B"
        },
        {
          "expr": "max by (table) (cnpg_waddle_ingress_table_dead_tuples)",
          "legendFormat": "dead {{table}}",
          "refId": "C"
        }
      ],
      "fieldConfig": { "defaults": {} },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 57 }
    },
    {
      "type": "timeseries",
      "title": "Postgres backends and max connections by instance",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum by (instance) (cnpg_backends_total)",
          "legendFormat": "backends {{instance}}",
          "refId": "A"
        },
        {
          "expr": "max by (instance) (cnpg_pg_settings_setting{name=\"max_connections\"})",
          "legendFormat": "max_connections {{instance}}",
          "refId": "B"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 65 }
    },
    {
      "type": "timeseries",
      "title": "WAL size, WAL volume, and WAL rate",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "max by (instance, value) (cnpg_collector_pg_wal{value=~\"size|volume_size\"})",
          "legendFormat": "wal {{value}} {{instance}}",
          "refId": "A"
        },
        {
          "expr": "max by (instance) (rate(cnpg_collector_wal_bytes[5m]))",
          "legendFormat": "wal rate {{instance}}",
          "refId": "B"
        }
      ],
      "fieldConfig": { "defaults": {} },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 65 }
    },
    {
      "type": "timeseries",
      "title": "Postgres PVC used and capacity",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "max by (persistentvolumeclaim) (kubelet_volume_stats_used_bytes{namespace=\"waddle\", persistentvolumeclaim=~\"postgresql-(1|2)(-wal)?\"})",
          "legendFormat": "used {{persistentvolumeclaim}}",
          "refId": "A"
        },
        {
          "expr": "max by (persistentvolumeclaim) (kubelet_volume_stats_capacity_bytes{namespace=\"waddle\", persistentvolumeclaim=~\"postgresql-(1|2)(-wal)?\"})",
          "legendFormat": "capacity {{persistentvolumeclaim}}",
          "refId": "B"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 73 }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["waddle", "delivery"],
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus",
        "regex": "/-prom$/",
        "current": { "selected": true, "text": "grafanacloud-waddlesocial-prom", "value": "grafanacloud-prom" }
      },
      {
        "name": "DS_LOKI",
        "type": "datasource",
        "query": "loki",
        "regex": "/-logs$/",
        "current": { "selected": true, "text": "grafanacloud-waddlesocial-logs", "value": "grafanacloud-logs" }
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "title": "Waddle delivery reliability",
  "uid": "waddle-delivery-reliability",
  "version": 1
}
