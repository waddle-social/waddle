+    )?;
+
+    let output = run_cuenv(root, &["sync", "-A"])?;
+    assert!(
+        output.success,
+        "sync -A must ignore malformed non-cuenv packages\nstdout: {}\nstderr: {}",
+        output.stdout,
+        output.stderr
+    );
+
+    Ok(())
+}
