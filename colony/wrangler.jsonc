{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "colony",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "compatibility_date": "2026-03-12",
  "compatibility_flags": [
    "global_fetch_strictly_public",
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "colony.waddle.social",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "colony",
      "database_id": "af273401-f1d0-4367-9d2a-84c76841ae3b",
      "migrations_dir": "./drizzle"
    }
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    "BETTER_AUTH_URL": "https://colony.waddle.social",
    "GITHUB_CLIENT_ID": "Ov23liag5CB15O5sIQ60"
  },
  "secrets_store_secrets": [
    {
      "binding": "BETTER_AUTH_SECRET",
      "store_id": "421985d6f384493c938c0554fea33c77",
      "secret_name": "BETTER_AUTH_SECRET"
    },
    {
      "binding": "GITHUB_CLIENT_SECRET",
      "store_id": "421985d6f384493c938c0554fea33c77",
      "secret_name": "GITHUB_CLIENT_SECRET"
    }
  ]
}
