---
const user = Astro.locals.user;
const session = Astro.locals.session;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Colony</title>
  </head>
  <body>
    <main>
      <h1>Colony</h1>
      <p>Astro 6. Cloudflare. D1. Better Auth.</p>

      {user && session ? (
        <>
          <p>Status: signed in.</p>
          <p>Name: {user.name ?? user.email}</p>
          <p>Email: {user.email}</p>
          <p>Session ID: {session.id}</p>
          <p><button id="sign-out" type="button">Sign out</button></p>
        </>
      ) : (
        <>
          <p>Status: signed out.</p>
          <p>Use GitHub OAuth to sign in.</p>
          <p><button id="sign-in" type="button">Sign in with GitHub</button></p>
        </>
      )}
    </main>

    <script>
      import { authClient } from "../lib/auth-client.ts";

      const signInButton = document.getElementById("sign-in");
      const signOutButton = document.getElementById("sign-out");

      signInButton?.addEventListener("click", async () => {
        await authClient.signIn.social({
          provider: "github",
          callbackURL: "/",
        });
      });

      signOutButton?.addEventListener("click", async () => {
        await authClient.signOut();
        window.location.reload();
      });
    </script>
  </body>
</html>
