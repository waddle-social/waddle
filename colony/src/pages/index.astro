---
import ColonyLayout from "../layouts/ColonyLayout.astro";

const user = Astro.locals.user;
const session = Astro.locals.session;
const githubUsername =
  user && "githubUsername" in user && typeof user.githubUsername === "string"
    ? user.githubUsername.trim()
    : "";
---

<ColonyLayout
  title="Colony"
  heading={user && session ? "Signed in" : "Identity for Waddle"}
  description={user && session ? "Your Waddle identity session is active." : "OAuth for Waddle services."}
  showHeader={false}
  showLogo={Boolean(!user || !session)}
>
  {user && session ? (
    <div class="stack">
      <dl class="detail-list">
        {githubUsername && (
          <div class="detail-row">
            <dt>Username</dt>
            <dd>{githubUsername}</dd>
          </div>
        )}
        <div class="detail-row">
          <dt>Name</dt>
          <dd>{user.name ?? user.email}</dd>
        </div>
        <div class="detail-row">
          <dt>Email</dt>
          <dd>{user.email}</dd>
        </div>
        <div class="detail-row">
          <dt>Session</dt>
          <dd class="session-id">{session.id}</dd>
        </div>
      </dl>
      <div class="button-row">
        <button class="button button--secondary" id="sign-out" type="button">Sign out</button>
      </div>
    </div>
  ) : (
    <div class="stack">
      <div class="button-row">
        <button class="button button--primary" id="sign-in" type="button">Continue with GitHub</button>
      </div>
    </div>
  )}

  <script>
    import { authClient } from "../lib/auth-client.ts";

    const signInButton = document.getElementById("sign-in");
    const signOutButton = document.getElementById("sign-out");

    signInButton?.addEventListener("click", async () => {
      await authClient.signIn.social({
        provider: "github",
        callbackURL: `${window.location.pathname}${window.location.search}`,
      });
    });

    signOutButton?.addEventListener("click", async () => {
      await authClient.signOut();
      window.location.reload();
    });
  </script>
</ColonyLayout>
