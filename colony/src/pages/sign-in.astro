---
import ColonyLayout from "../layouts/ColonyLayout.astro";

const user = Astro.locals.user;

if (user) {
  return Astro.redirect(Astro.url.searchParams.get("redirect") ?? "/");
}
---

<ColonyLayout
  title="Sign In - Colony"
  heading="Sign in"
  description="Use your Waddle account to continue."
>
  <div class="button-row">
    <button class="button button--primary" id="sign-in" type="button">Continue with GitHub</button>
  </div>

  <script>
    import { authClient } from "../lib/auth-client.ts";

    const signInButton = document.getElementById("sign-in");

    signInButton?.addEventListener("click", async () => {
      await authClient.signIn.social({
        provider: "github",
        callbackURL: window.location.href,
      });
    });
  </script>
</ColonyLayout>
