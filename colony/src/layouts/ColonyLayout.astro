---
import { Font } from "astro:assets";
import mark from "@waddle/design/assets/waddle-mark.svg?url";
import "../styles/global.css";
import { css, cx } from "../../styled-system/css";
import { card, sea } from "../../styled-system/recipes";

interface Props {
  title: string;
  width?: "sm" | "md" | "lg";
}

const { title, width = "sm" } = Astro.props;
const widths = {
  sm: css({ maxWidth: "400px", gap: "4" }),
  md: css({ maxWidth: "440px", gap: "4" }),
  lg: css({ maxWidth: "520px", gap: "5" }),
};
---

<html lang="en" data-theme="night">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/logo.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#060f19" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f7f9fb" />
    <script is:inline>
      const light = matchMedia("(prefers-color-scheme: light)");
      const applyTheme = () => {
        document.documentElement.dataset.theme = light.matches ? "daylight" : "night";
      };
      applyTheme();
      light.addEventListener("change", applyTheme);
    </script>
    <title>{title}</title>
    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-body" preload />
    <Font cssVariable="--font-mono" />
  </head>
  <body>
    <main
      class={cx(
        sea(),
        css({
          // The board's tighter sea glow; the recipe default is 120% 80%.
          bgImage: "radial-gradient(90% 70% at 50% 0%, {colors.sea.shallow}, {colors.sea} 55%, {colors.sea.deep})",
          minHeight: "100dvh",
          boxSizing: "border-box",
          flexDirection: "column",
          alignItems: "center",
          gap: "5",
          px: "4",
          py: "12",
        }),
      )}
    >
      <section class={cx(card(), css({ borderRadius: "panel", p: "8" }), widths[width])}>
        <div class={css({ display: "flex", alignItems: "center", gap: "3" })}>
          <span
            class={css({
              display: "inline-flex",
              alignItems: "center",
              justifyContent: "center",
              flex: "none",
              width: "52px",
              height: "52px",
              borderRadius: "pill",
              bg: "belly",
            })}
          >
            <img src={mark} alt="Waddle" width="36" height="36" />
          </span>
          <slot name="mark" />
        </div>
        <slot />
      </section>
      <p class={css({ m: 0, fontSize: "xs", color: "fg.muted", textAlign: "center" })}>
        <slot name="footer"><span class={css({ fontFamily: "mono" })}>{Astro.url.host}</span></slot>
      </p>
    </main>
  </body>
</html>
