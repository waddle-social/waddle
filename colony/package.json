{
  "name": "@waddle/colony",
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "astro": "astro",
    "deploy": "wrangler deploy",
    "generate-types": "wrangler types",
    "auth:generate": "sh -ac 'set -a; . ./.auth.env; set +a; bunx @better-auth/cli generate --config src/lib/auth.schema.ts --output src/db/schema.ts --yes'",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^13.2.0",
    "@better-auth/drizzle-adapter": "^1.6.7",
    "@better-auth/oauth-provider": "^1.6.7",
    "astro": "^6.1.9",
    "better-auth": "^1.6.7",
    "drizzle-orm": "^0.45.2",
    "wrangler": "^4.84.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.8",
    "@cloudflare/workers-types": "^4.20260422.1",
    "drizzle-kit": "^0.31.10",
    "typescript": "^6.0.3"
  }
}
