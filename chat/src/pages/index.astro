---
import "../styles/global.css";

const user = Astro.locals.user;
const session = Astro.locals.session;
const identity = user?.name?.trim() || user?.email || "Signed in";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>chat.waddle.social</title>
  </head>
  <body>
    <main>
      <div class="stack">
        <h1>chat.waddle.social</h1>
        {user && session ? (
          <section class="account" aria-label="Logged in area">
            <p class="status">Signed in</p>
            <p class="identity">{identity}</p>
            {user.name && user.email ? <p class="detail">{user.email}</p> : null}
            <button id="sign-out" type="button">Log out</button>
          </section>
        ) : (
          <>
            <button id="sign-in" type="button">Sign in with Colony</button>
          </>
        )}
      </div>
    </main>

    <script>
      import { authClient } from "../lib/auth-client.ts";

      const signInButton = document.getElementById("sign-in");
      const signOutButton = document.getElementById("sign-out");

      signInButton?.addEventListener("click", async () => {
        await authClient.signIn.oauth2({
          providerId: "colony",
          callbackURL: "/",
        });
      });

      signOutButton?.addEventListener("click", async () => {
        await authClient.signOut();
        window.location.reload();
      });
    </script>
  </body>
</html>
