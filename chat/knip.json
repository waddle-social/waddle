{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/components/ChatApp.vue",
    "src/components/XmppProvider.vue",
    "src/vue-app.ts",
    "src/service-worker/sw-template.js",
    "scripts/*.mjs",
    "tests/**/*.test.ts"
  ],
  "project": [
    "src/**/*.{ts,vue,astro,mjs}",
    "scripts/**/*.mjs",
    "tests/**/*.ts"
  ],
  "ignore": [
    "src/lib/xmpp/extensions/fallback.ts",
    "src/lib/xmpp/extensions/file-sharing.ts",
    "src/lib/xmpp/extensions/forums.ts",
    "src/lib/xmpp/extensions/hats.ts",
    "src/lib/xmpp/extensions/index.ts",
    "src/lib/xmpp/extensions/markup.ts",
    "src/lib/xmpp/extensions/mentions.ts",
    "src/lib/xmpp/extensions/push.ts",
    "src/lib/xmpp/extensions/reactions.ts",
    "src/lib/xmpp/extensions/references.ts",
    "src/lib/xmpp/extensions/replies.ts",
    "src/lib/xmpp/extensions/retraction.ts",
    "src/lib/xmpp/extensions/stanza-ids.ts",
    "src/lib/xmpp/extensions/stickers.ts"
  ],
  "astro": true,
  "ignoreDependencies": [
    "@fontsource-variable/jetbrains-mono",
    "@fontsource-variable/outfit",
    "tailwindcss",
    "events",
    "cloudflare"
  ]
}
