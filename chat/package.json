{
  "name": "chat",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "bun": ">=1.3.10",
    "node": ">=22.12.0"
  },
  "scripts": {
    "generate-service-worker": "bun run scripts/generate-service-worker.mjs",
    "copy-background-assets": "bun run scripts/copy-background-assets.mjs",
    "wasm:build": "bun run scripts/build-xmpp-wasm.mjs",
    "dev": "bun run wasm:build && bun run panda:codegen && bun run generate-service-worker && bun run copy-background-assets && astro dev",
    "build": "bun run wasm:build && bun run panda:codegen && bun run generate-service-worker && bun run copy-background-assets && astro check && astro build",
    "preview": "bun run build && astro preview",
    "astro": "bun run wasm:build && bun run panda:codegen && astro",
    "test": "bun run panda:codegen && bun test",
    "generate-types": "wrangler types",
    "sourcemaps:strip": "bun run scripts/strip-sourcemaps.mjs",
    "deploy": "bun run build && bun run sourcemaps:strip && wrangler deploy",
    "lint": "bun run wasm:build && bun run panda:codegen && knip",
    "lint:fix": "bun run wasm:build && bun run panda:codegen && knip --fix --allow-remove-files",
    "panda:codegen": "panda codegen --silent"
  },
  "dependencies": {
    "@ark-ui/vue": "5.39.2",
    "@astrojs/cloudflare": "^13.6.1",
    "@astrojs/vue": "^6.0.1",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource-variable/outfit": "^5.2.8",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@grafana/faro-web-sdk": "^2.7.0",
    "@grafana/faro-web-tracing": "^2.7.0",
    "@livekit/track-processors": "^0.7.2",
    "@nanostores/vue": "^1.1.0",
    "@opentelemetry/api": "^1.9.1",
    "@sapphi-red/web-noise-suppressor": "0.3.5",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/vue-query": "^5.101.0",
    "@tanstack/vue-virtual": "^3.13.28",
    "@tiptap/core": "^3.25.0",
    "@tiptap/extension-code-block": "^3.25.0",
    "@tiptap/extension-link": "^3.25.0",
    "@tiptap/extension-placeholder": "^3.25.0",
    "@tiptap/pm": "^3.25.0",
    "@tiptap/starter-kit": "^3.25.0",
    "@tiptap/vue-3": "^3.25.0",
    "@workadventure/noise-suppression": "0.0.4",
    "astro": "^6.4.3",
    "effect": "3.22.0",
    "emojilib": "^4.0.3",
    "events": "^3.3.0",
    "hls.js": "^1.6.16",
    "keystrok": "^0.1.1",
    "livekit-client": "^2.21.0",
    "lucide-vue-next": "^1.0.0",
    "nanostores": "^1.3.0",
    "shiki": "^4.2.0",
    "tailwindcss": "^4.3.0",
    "vue": "^3.5.35",
    "wrangler": "^4.97.0"
  },
  "optionalDependencies": {
    "@waddle/xmpp-client-wasm": "file:../server/wasm-pkg/waddle-xmpp-client-wasm"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@cloudflare/workers-types": "^4.20260603.1",
    "@grafana/faro-rollup-plugin": "^0.11.0",
    "@pandacss/dev": "1.12.1",
    "@pandacss/postcss": "1.12.1",
    "@pandacss/preset-base": "1.12.1",
    "@pandacss/preset-panda": "1.12.1",
    "@types/node": "^25.9.1",
    "knip": "^6.15.0",
    "postcss": "^8.5.28",
    "typescript": "^6.0.3"
  }
}
