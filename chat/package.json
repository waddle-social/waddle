{
  "name": "chat",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "bun": ">=1.3.10",
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "generate-types": "wrangler types",
    "deploy": "wrangler deploy",
    "auth:generate": "sh -ac 'set -a; . ./.auth.env; set +a; bunx @better-auth/cli generate --config src/lib/auth.schema.ts --output src/db/schema.ts --yes'",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^13.1.3",
    "@astrojs/vue": "^6.0.1",
    "@better-auth/drizzle-adapter": "^1.5.5",
    "@tailwindcss/vite": "^4.2.2",
    "astro": "^6.0.8",
    "better-auth": "^1.5.5",
    "drizzle-orm": "^0.45.1",
    "tailwindcss": "^4.2.2",
    "vue": "^3.5.30",
    "wrangler": "^4.76.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.8",
    "@cloudflare/workers-types": "^4.20260317.1",
    "@types/node": "^24.10.1",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.9.3"
  }
}
