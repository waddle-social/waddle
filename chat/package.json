{
  "name": "chat",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "bun": ">=1.3.10",
    "node": ">=22.12.0"
  },
  "scripts": {
    "generate-service-worker": "bun run scripts/generate-service-worker.mjs",
    "wasm:build": "bun run scripts/build-xmpp-wasm.mjs",
    "dev": "bun run wasm:build && bun run generate-service-worker && astro dev",
    "build": "bun run wasm:build && bun run generate-service-worker && astro check && astro build",
    "preview": "bun run wasm:build && bun run generate-service-worker && astro preview",
    "astro": "astro",
    "generate-types": "wrangler types",
    "deploy": "bun run wasm:build && bun run generate-service-worker && wrangler deploy",
    "lint": "bun run wasm:build && knip",
    "lint:fix": "bun run wasm:build && knip --fix --allow-remove-files"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^13.1.10",
    "@astrojs/vue": "^6.0.1",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource-variable/outfit": "^5.2.8",
    "@grafana/faro-web-sdk": "^2.3.1",
    "@grafana/faro-web-tracing": "^2.3.1",
    "@nanostores/vue": "^1.1.0",
    "@opentelemetry/api": "^1.9.1",
    "@tailwindcss/vite": "^4.2.3",
    "@tanstack/vue-query": "^5.100.6",
    "@tanstack/vue-virtual": "^3.13.24",
    "@tiptap/core": "^3.22.4",
    "@tiptap/extension-code-block": "^3.22.4",
    "@tiptap/extension-link": "^3.22.4",
    "@tiptap/extension-placeholder": "^3.22.4",
    "@tiptap/pm": "^3.22.4",
    "@tiptap/starter-kit": "^3.22.4",
    "@tiptap/vue-3": "^3.22.4",
    "astro": "^6.1.8",
    "emojilib": "^4.0.3",
    "events": "^3.3.0",
    "keystrok": "^0.1.1",
    "lucide-vue-next": "^1.0.0",
    "nanostores": "^1.3.0",
    "shiki": "^4.0.2",
    "tailwindcss": "^4.2.3",
    "vue": "^3.5.32",
    "wrangler": "^4.84.0"
  },
  "optionalDependencies": {
    "@waddle/xmpp-client-wasm": "file:../server/wasm-pkg/waddle-xmpp-client-wasm"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.8",
    "@cloudflare/workers-types": "^4.20260420.1",
    "@types/node": "^25.6.0",
    "knip": "^6.5.0",
    "typescript": "^6.0.3"
  }
}
