{
  "name": "chat",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "bun": ">=1.3.10",
    "node": ">=22.12.0"
  },
  "scripts": {
    "generate-service-worker": "bun run scripts/generate-service-worker.mjs",
    "dev": "bun run generate-service-worker && astro dev",
    "build": "bun run generate-service-worker && astro check && astro build",
    "preview": "bun run generate-service-worker && astro preview",
    "astro": "astro",
    "generate-types": "wrangler types",
    "deploy": "bun run generate-service-worker && wrangler deploy",
    "lint": "knip",
    "lint:fix": "knip --fix --allow-remove-files"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^13.1.10",
    "@astrojs/vue": "^6.0.1",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource-variable/outfit": "^5.2.8",
    "@fontsource-variable/syne": "^5.2.7",
    "@grafana/faro-web-sdk": "^2.3.1",
    "@nanostores/vue": "^1.1.0",
    "@tailwindcss/vite": "^4.2.3",
    "@tiptap/extension-link": "^3.22.4",
    "@tiptap/extension-placeholder": "^3.22.4",
    "@tiptap/pm": "^3.22.4",
    "@tiptap/starter-kit": "^3.22.4",
    "@tiptap/vue-3": "^3.22.4",
    "astro": "^6.1.8",
    "emojilib": "^4.0.3",
    "events": "^3.3.0",
    "lucide-vue-next": "^1.0.0",
    "nanostores": "^1.3.0",
    "shiki": "^4.0.2",
    "stanza": "^12.22.1",
    "tailwindcss": "^4.2.3",
    "vue": "^3.5.32",
    "wrangler": "^4.84.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.8",
    "@cloudflare/workers-types": "^4.20260420.1",
    "@types/node": "^25.6.0",
    "knip": "^6.5.0",
    "typescript": "^6.0.3"
  }
}
