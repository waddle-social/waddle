{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "paths": {
      "@/*": [
        "src/*"
      ],
      "styled-system/*": [
        "styled-system/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "src/**/*.vue",
    "src/**/*.astro",
    "worker-configuration.d.ts",
    "styled-system/**/*.d.ts"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}
