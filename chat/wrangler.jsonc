{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chat",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "compatibility_date": "2026-03-17",
  "compatibility_flags": [
    "global_fetch_strictly_public",
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "chat.waddle.social",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "chat",
      "database_id": "a970b2fb-33c2-494c-905b-b26ac3b0d796",
      "migrations_dir": "./drizzle"
    }
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    "BETTER_AUTH_URL": "https://chat.waddle.social",
    "COLONY_AUTH_URL": "https://colony.waddle.social",
    "COLONY_OIDC_CLIENT_ID": "waddle-chat"
  },
  "secrets_store_secrets": [
    {
      "binding": "BETTER_AUTH_SECRET",
      "store_id": "421985d6f384493c938c0554fea33c77",
      "secret_name": "BETTER_AUTH_SECRET"
    }
  ]
}
