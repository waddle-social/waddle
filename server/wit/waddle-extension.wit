package waddle:extension@1.0.0;

interface types {
    record detected-link {
        url: string,
        start-offset: u32,
        end-offset: u32,
    }

    record action-id {
        value: string,
    }

    record artifact-uri {
        value: string,
    }

    record command-node {
        value: string,
    }

    record command-session-id {
        value: string,
    }

    record display-text {
        value: string,
    }

    record full-jid {
        value: string,
    }

    record enrichment-id {
        value: string,
    }

    record list-id {
        value: string,
    }

    record list-item-id {
        value: string,
    }

    record launch-id {
        value: string,
    }

    record route-id {
        value: string,
    }

    record media-type {
        value: string,
    }

    record payload-namespace {
        value: string,
    }

    record plugin-id {
        value: string,
    }

    record plugin-version {
        value: string,
    }

    record pubsub-item-id {
        value: string,
    }

    record pubsub-node {
        value: string,
    }

    record room-jid {
        value: string,
    }

    record sha256-digest {
        value: string,
    }

    record stanza-id {
        value: string,
    }

    record timestamp {
        value: string,
    }

    record thread-id {
        value: string,
    }

    record ui-action-id {
        value: string,
    }

    record ui-view-id {
        value: string,
    }

    record url {
        value: string,
    }

    record waddle-id {
        value: string,
    }

    record body-range {
        start: u32,
        end: u32,
    }

    record artifact-reference {
        uri: artifact-uri,
        sha256: sha256-digest,
        media-type: option<media-type>,
    }

    enum extension-capability {
        message-enrich,
        message-observe,
        host-channels-read,
        host-spaces-read,
        host-members-read,
        host-presence-read,
        host-mam-read,
        host-roster-read,
        host-message-send,
        outbound-http-request,
        commands,
        launch,
        pubsub-publish,
        artifact-reference,
        ui-declarative,
    }

    enum extension-route-scope {
        channel,
    }

    enum extension-route-surface {
        gallery,
        list-view,
    }

    record payload-root {
        namespace: payload-namespace,
        local-name: string,
    }

    enum payload-surface {
        message-enrichment,
        launch-payload,
        pubsub-item,
    }

    record payload-rule {
        surface: payload-surface,
        root: payload-root,
    }

    record extension-manifest {
        id: plugin-id,
        name: display-text,
        version: plugin-version,
        payloads: list<payload-rule>,
        capabilities: list<extension-capability>,
        commands: list<command-descriptor>,
        routes: list<extension-route-descriptor>,
        pubsub-nodes: list<pubsub-node>,
        artifact: option<artifact-reference>,
    }

    enum command-scope {
        global,
        channel,
    }

    record command-descriptor {
        node: command-node,
        name: display-text,
        scope: command-scope,
    }

    record extension-route-descriptor {
        plugin: plugin-id,
        id: route-id,
        label: display-text,
        scope: extension-route-scope,
        surface: extension-route-surface,
        state-node: pubsub-node,
        payload-namespace: payload-namespace,
    }

    enum text-style {
        body,
        heading,
        muted,
        code,
    }

    record text-block {
        text: display-text,
        style: text-style,
    }

    record image-block {
        artifact: artifact-reference,
        alt: display-text,
    }

    record action-block {
        launch-id: launch-id,
        label: display-text,
    }

    record form-field-option {
        label: option<display-text>,
        value: data-form-value,
    }

    enum form-field-type {
        boolean,
        fixed,
        hidden,
        jid-multi,
        jid-single,
        list-multi,
        list-single,
        text-multi,
        text-private,
        text-single,
    }

    record data-form-field {
        name: ui-action-id,
        field-type: form-field-type,
        label: option<display-text>,
        required: bool,
        values: list<data-form-value>,
        options: list<form-field-option>,
    }

    record data-form-value {
        value: string,
    }

    enum data-form-type {
        form,
        submit,
        cancel,
        result-form,
    }

    record data-form {
        form-type: data-form-type,
        title: option<display-text>,
        instructions: list<display-text>,
        fields: list<data-form-field>,
    }

    variant ui-block {
        text(text-block),
        image(image-block),
        action(action-block),
        form(data-form),
        list-block(list-view),
    }

    record ui-view {
        id: ui-view-id,
        title: option<display-text>,
        blocks: list<ui-block>,
    }

    record list-item {
        id: list-item-id,
        label: display-text,
        description: option<display-text>,
        image: option<artifact-reference>,
        launch-id: option<launch-id>,
    }

    record list-view {
        id: list-id,
        title: option<display-text>,
        items: list<list-item>,
    }

    record xml-attribute {
        namespace: option<payload-namespace>,
        local-name: string,
        value: string,
    }

    record xml-element {
        namespace: payload-namespace,
        local-name: string,
        attributes: list<xml-attribute>,
    }

    variant xml-token {
        start-element(xml-element),
        end-element,
        text(string),
    }

    record extension-payload {
        namespace: payload-namespace,
        root: payload-root,
        tokens: list<xml-token>,
    }

    record launch-context {
        waddle-id: waddle-id,
        room: option<room-jid>,
        source-stanza-id: option<stanza-id>,
    }

    record launch-descriptor {
        id: launch-id,
        plugin: plugin-id,
        action: action-id,
        command-node: command-node,
        label: display-text,
        context: launch-context,
        payloads: list<extension-payload>,
        fallback: option<ui-view>,
        expires-at: option<timestamp>,
    }

    record message-source {
        stanza-id: stanza-id,
        body-range: option<body-range>,
    }

    record message-enrichment {
        id: enrichment-id,
        plugin: plugin-id,
        capability: extension-capability,
        payload-namespace: payload-namespace,
        created-at: timestamp,
        source: option<message-source>,
        ui: list<ui-view>,
        payloads: list<extension-payload>,
        launches: list<launch-descriptor>,
    }

    record extension-envelope {
        version: u32,
        enrichments: list<message-enrichment>,
    }

    record reply-target {
        id: stanza-id,
        to: option<full-jid>,
    }

    record message-context {
        waddle-id: waddle-id,
        stanza-id: option<stanza-id>,
        room: option<room-jid>,
        sender: option<full-jid>,
        thread-id: option<thread-id>,
        reply-to: option<reply-target>,
    }

    record link-target {
        url: url,
        range: body-range,
    }

    record message-hook {
        context: message-context,
        body: display-text,
        links: list<link-target>,
    }

    record form-field-value {
        name: ui-action-id,
        values: list<data-form-value>,
    }

    enum command-action {
        execute,
        next,
        prev,
        complete,
        cancel,
    }

    record command-invocation {
        waddle-id: waddle-id,
        room: option<room-jid>,
        requester: full-jid,
        command-node: command-node,
        session-id: option<command-session-id>,
        action: option<command-action>,
        form: option<data-form>,
        fields: list<form-field-value>,
    }

    record launch-invocation {
        context: launch-context,
        requester: full-jid,
        launch-id: launch-id,
        session-id: option<command-session-id>,
        action: option<command-action>,
        form: option<data-form>,
        fields: list<form-field-value>,
    }

    variant extension-event {
        message-hook(message-hook),
        command(command-invocation),
        launch(launch-invocation),
    }

    record pubsub-publish {
        node: pubsub-node,
        item-id: option<pubsub-item-id>,
        payload: extension-payload,
    }

    variant extension-effect {
        enrich-message(extension-envelope),
        publish-pubsub(pubsub-publish),
        reference-artifact(artifact-reference),
        command-form(data-form),
        host-warning(display-text),
        noop,
    }

    record extension-response {
        effects: list<extension-effect>,
    }

    enum extension-error-code {
        unsupported-event,
        invalid-request,
        denied,
        temporary-failure,
    }

    record extension-error {
        code: extension-error-code,
        message: display-text,
    }

    record bare-jid {
        value: string,
    }

    record jid {
        value: string,
    }

    record channel-summary {
        room: room-jid,
        name: option<display-text>,
        description: option<display-text>,
    }

    record list-channels-request {
        reserved: option<string>,
    }

    record list-channels-response {
        channels: list<channel-summary>,
    }

    record space-summary {
        service: bare-jid,
        node: pubsub-node,
        name: option<display-text>,
        description: option<display-text>,
        channels: list<room-jid>,
    }

    record list-spaces-request {
        reserved: option<string>,
    }

    record list-spaces-response {
        spaces: list<space-summary>,
    }

    enum muc-role {
        none,
        visitor,
        participant,
        moderator,
    }

    enum muc-affiliation {
        none,
        outcast,
        member,
        admin,
        owner,
    }

    record room-member {
        room: room-jid,
        jid: jid,
        nick: option<display-text>,
        role: muc-role,
        affiliation: muc-affiliation,
    }

    record list-room-members-request {
        room: room-jid,
    }

    record list-room-members-response {
        members: list<room-member>,
    }

    enum presence-availability {
        available,
        unavailable,
    }

    enum presence-show {
        chat,
        away,
        xa,
        dnd,
    }

    record presence-state {
        jid: jid,
        availability: presence-availability,
        show: option<presence-show>,
        status: option<display-text>,
        priority: s32,
    }

    record get-presence-request {
        subject: bare-jid,
    }

    record get-presence-response {
        resources: list<presence-state>,
    }

    enum roster-subscription {
        none,
        subscribed-to,
        subscribed-from,
        both,
        remove,
    }

    enum roster-ask {
        subscribe,
    }

    record roster-entry {
        jid: bare-jid,
        name: option<display-text>,
        subscription: roster-subscription,
        ask: option<roster-ask>,
        groups: list<display-text>,
    }

    record get-roster-request {
        owner: bare-jid,
    }

    record get-roster-response {
        entries: list<roster-entry>,
    }

    variant mam-target {
        room(room-jid),
        conversation(bare-jid),
    }

    record mam-query {
        target: mam-target,
        start: option<timestamp>,
        end: option<timestamp>,
        thread-id: option<thread-id>,
        sender: option<bare-jid>,
        text: option<display-text>,
        max-results: u32,
    }

    record archived-message {
        stanza-id: stanza-id,
        from-jid: jid,
        to-jid: jid,
        sent-at: timestamp,
        body: option<display-text>,
        thread-id: option<thread-id>,
        reply-to: option<reply-target>,
    }

    record mam-query-response {
        messages: list<archived-message>,
        complete: bool,
    }

    variant message-target {
        muc(room-jid),
        direct(bare-jid),
    }

    record send-message-request {
        target: message-target,
        body: display-text,
        thread-id: option<thread-id>,
        reply-to: option<reply-target>,
        extensions: option<extension-envelope>,
    }

    record send-message-response {
        stanza-id: stanza-id,
    }

    enum host-tool-error-code {
        denied,
        invalid-request,
        not-found,
        unsupported,
        temporary-failure,
    }

    record host-tool-error {
        code: host-tool-error-code,
        message: display-text,
    }

    enum http-method {
        get,
        post,
    }

    record http-header {
        name: string,
        value: string,
    }

    record outgoing-http-request {
        method: http-method,
        url: url,
        headers: list<http-header>,
        body: option<string>,
    }

    record http-response {
        status: u16,
        body: string,
    }
}

interface framework {
    use types.{extension-error, extension-event, extension-response};
    handle-event: func(event: extension-event) -> result<extension-response, extension-error>;
}

interface lifecycle {
    use types.{extension-manifest};
    init: func(config: string) -> result<extension-manifest, string>;
}

interface host-tools {
    use types.{
        get-presence-request, get-presence-response, get-roster-request,
        get-roster-response, host-tool-error, list-channels-request,
        list-channels-response, list-room-members-request,
        list-room-members-response, list-spaces-request, list-spaces-response,
        mam-query, mam-query-response, send-message-request, send-message-response
    };

    list-channels: func(request: list-channels-request) -> result<list-channels-response, host-tool-error>;
    list-spaces: func(request: list-spaces-request) -> result<list-spaces-response, host-tool-error>;
    list-room-members: func(request: list-room-members-request) -> result<list-room-members-response, host-tool-error>;
    get-presence: func(request: get-presence-request) -> result<get-presence-response, host-tool-error>;
    get-roster: func(request: get-roster-request) -> result<get-roster-response, host-tool-error>;
    query-mam: func(query: mam-query) -> result<mam-query-response, host-tool-error>;
    send-message: func(request: send-message-request) -> result<send-message-response, host-tool-error>;
}

interface runtime {
    use types.{host-tool-error, outgoing-http-request, http-response};

    get-config: func() -> string;
    http-request: func(request: outgoing-http-request) -> result<http-response, host-tool-error>;

    /// Current wall-clock time, formatted as an RFC 3339 / ISO 8601 string in
    /// UTC. Extensions call this when populating `created_at`, `expires_at`,
    /// `saved-at` and similar fields so that wall-clock authority stays on the
    /// host and every published item gets a fresh timestamp.
    current-timestamp: func() -> string;
}

world waddle-extension {
    import wasi:logging/logging@0.1.0-draft;
    import wasi:clocks/monotonic-clock@0.2.0;
    import host-tools;
    import runtime;

    export lifecycle;
    export framework;
}
