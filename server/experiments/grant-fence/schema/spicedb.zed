definition fence_user {}

definition fence_generation {
    relation reader: fence_user
    permission read = reader
}

definition recovery_subject {}

definition recovery_operation {
    relation marker: recovery_subject
    relation reader: recovery_subject
    relation tombstone: recovery_subject
    permission read = reader
}

// Fixed experimental policy. No MUC behavior or production schema is represented.
definition multi_user {}
definition multi_stamp {}
definition multi_marker {
    relation version: multi_stamp
}
definition multi_parent {
    relation member: multi_user
    permission inherited = member
}
definition multi_channel {
    relation parent: multi_parent
    relation direct: multi_user
    // Used only by a negative control; ordinary proof worlds leave it empty.
    relation control_denied: multi_user
    permission inherited = parent->inherited - control_denied
    permission direct_access = direct
}
