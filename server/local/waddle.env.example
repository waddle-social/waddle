# Copy to local/waddle.env and replace the placeholder secret before using local auth.

WADDLE_MODE=homeserver
WADDLE_BASE_URL=http://localhost:3000
WADDLE_DB_PATH=./local/data/waddle.db
WADDLE_UPLOAD_DIR=./local/uploads
WADDLE_CORS_ORIGINS=http://localhost:4321,http://localhost:3000
WADDLE_XMPP_ENABLED=true
WADDLE_XMPP_DOMAIN=waddle.social
WADDLE_XMPP_TLS_CERT=./local/certs/server.crt
WADDLE_XMPP_TLS_KEY=./local/certs/server.key
WADDLE_XMPP_S2S_ENABLED=false
WADDLE_NATIVE_AUTH_ENABLED=true
WADDLE_REGISTRATION_ENABLED=false
WADDLE_SESSION_KEY=6c2d7217b47441e3b4f8b47fd8efb346574380e00dbf4e0eb38166d8f9fbd176
WADDLE_AUTH_PROVIDERS_JSON='[{"id":"colony","display_name":"Colony","kind":"oidc","issuer":"https://colony.waddle.social","client_id":"waddle-server","client_secret":"replace-me","scopes":["openid","profile","email"],"subject_claim":"sub","username_claim":"preferred_username","email_claim":"email"}]'
