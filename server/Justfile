set shell := ["bash", "-euo", "pipefail", "-c"]

default:
    @just --list

# Run all XMPP protocol unit/integration tests.
test:
    cargo test -p waddle-xmpp

# Run all waddle-xmpp integration tests.
integration:
    cargo test -p waddle-xmpp --tests --verbose

# Run active WebSocket C2S integration tests.
websocket:
    cargo test -p waddle-server --test xep0092_software_version_ws --test xep0012_0202_ws --test xep0054_0049_0191_ws --verbose

# Run only inline unit tests.
unit:
    cargo test -p waddle-xmpp --lib --verbose

# Run the full workspace test suite (all crates).
test-all:
    cargo test --workspace --all-targets

# Lint and format check.
lint:
    cargo fmt --all -- --check
    cargo clippy --all-targets --all-features -- -D warnings
