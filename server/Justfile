set shell := ["bash", "-euo", "pipefail", "-c"]

default:
    @just --list

# Run all XMPP tests (unit + integration + conformance).
test:
    cargo test -p waddle-xmpp

# Run only the protocol conformance suite.
conformance:
    cargo test -p waddle-xmpp --test protocol_conformance --verbose

# Run all integration tests (XEP + RFC + E2E).
integration:
    cargo test -p waddle-xmpp --tests --verbose

# Run only inline unit tests.
unit:
    cargo test -p waddle-xmpp --lib --verbose

# Run the full workspace test suite (all crates).
test-all:
    cargo test --workspace --all-targets

# Lint and format check.
lint:
    cargo fmt --all -- --check
    cargo clippy --all-targets --all-features -- -D clippy::correctness
