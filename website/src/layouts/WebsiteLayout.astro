---
import { Font } from "astro:assets";

import "../styles/global.css";

interface Props {
	title?: string;
	description?: string;
	ogTitle?: string;
	canonicalPath?: string;
}

const site = Astro.site ?? new URL("https://waddle.social");
const title = Astro.props.title ?? "waddle.social";
const description =
	Astro.props.description ?? "Open-source, XMPP-native social chat — yours by default.";
const canonicalPath = Astro.props.canonicalPath ?? Astro.url.pathname;
const canonicalUrl = new URL(canonicalPath, site);
const ogTitle = Astro.props.ogTitle ?? title;
const ogImageUrl = new URL("/og-image.png", site);
const ogImageAlt =
	"waddle.social: Social chat that's yours by default. Three penguins in winter hats on an ice floe.";
---

<html lang="en" data-theme="night">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/waddle-logo.svg" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
		<link rel="shortcut icon" href="/favicon.ico" />
		<link rel="canonical" href={canonicalUrl} />
		<meta
			name="viewport"
			content="width=device-width, initial-scale=1, viewport-fit=cover"
		/>
		<link rel="manifest" href="/manifest.webmanifest" />
		<meta name="apple-mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
		<meta name="apple-mobile-web-app-title" content="Waddle" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<meta name="mobile-web-app-capable" content="yes" />
		<meta name="color-scheme" content="dark light" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="theme-color" media="(prefers-color-scheme: light)" content="#f1f8ff" />
		<meta name="theme-color" media="(prefers-color-scheme: dark)" content="#041a32" />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="waddle.social" />
		<meta property="og:title" content={ogTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={ogImageAlt} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={ogTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageUrl} />
		<meta name="twitter:image:alt" content={ogImageAlt} />
		<title>{title}</title>
		<Font cssVariable="--font-display" preload />
		<Font cssVariable="--font-body" preload />
		<Font cssVariable="--font-mono" />
		<script is:inline>
			// A saved choice wins (light/dark; night/daylight also read); otherwise follow the system live.
			const prefersLight = matchMedia("(prefers-color-scheme: light)");
			const applyTheme = () => {
				let saved = null;
				try {
					saved = localStorage.getItem("waddle-theme");
				} catch {}
				const isLight =
					saved === "light" || saved === "daylight"
						? true
						: saved === "dark" || saved === "night"
							? false
							: prefersLight.matches;
				document.documentElement.dataset.theme = isLight ? "daylight" : "night";
			};
			applyTheme();
			prefersLight.addEventListener("change", applyTheme);
		</script>
	</head>
	<body>
		<slot />

		<script>
			// Tri-state: System (nothing saved), then Night, then Daylight, then System again.
			const root = document.documentElement;
			const toggles = document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]");
			const prefersLight = matchMedia("(prefers-color-scheme: light)");
			const LABELS = { system: "System", night: "Night", daylight: "Daylight" } as const;
			const NEXT = { system: "night", night: "daylight", daylight: "system" } as const;
			type Choice = keyof typeof LABELS;
			const readChoice = (): Choice => {
				let saved = null;
				try {
					saved = localStorage.getItem("waddle-theme");
				} catch {}
				if (saved === "light" || saved === "daylight") return "daylight";
				if (saved === "dark" || saved === "night") return "night";
				return "system";
			};
			let choice = readChoice();
			const sync = () => {
				const label = `Theme: ${LABELS[choice]}. Switch to ${LABELS[NEXT[choice]]}.`;
				toggles.forEach((el) => {
					el.dataset.choice = choice;
					el.setAttribute("aria-label", label);
					el.title = label;
				});
			};
			sync();
			// The head script still switches the theme when the system setting changes.
			new MutationObserver(() => {
				sync();
				window.dispatchEvent(new Event("waddle:theme-change"));
			}).observe(root, { attributeFilter: ["data-theme"] });
			toggles.forEach((el) => {
				el.addEventListener("click", () => {
					choice = NEXT[choice];
					try {
						if (choice === "system") localStorage.removeItem("waddle-theme");
						else localStorage.setItem("waddle-theme", choice === "daylight" ? "light" : "dark");
					} catch {}
					const isLight = choice === "system" ? prefersLight.matches : choice === "daylight";
					root.dataset.theme = isLight ? "daylight" : "night";
					sync();
				});
			});
		</script>
		</script>
	</body>
</html>
