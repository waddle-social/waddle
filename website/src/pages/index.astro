---
import WebsiteLayout from "../layouts/WebsiteLayout.astro";
import {
	WAITLIST_INVALID_MESSAGE,
	WAITLIST_PENDING_MESSAGE,
	WAITLIST_QUERY_KEY,
	WAITLIST_RETRY_MESSAGE,
	WAITLIST_SUCCESS_MESSAGE,
} from "../lib/waitlist/constants";

const waitlistState = Astro.url.searchParams.get(WAITLIST_QUERY_KEY);
const initialStatus =
	waitlistState === "submitted"
		? { tone: "success", message: WAITLIST_SUCCESS_MESSAGE }
		: waitlistState === "invalid"
			? { tone: "error", message: WAITLIST_INVALID_MESSAGE }
			: waitlistState === "retry"
				? { tone: "error", message: WAITLIST_RETRY_MESSAGE }
		: null;
const waitlistStartsOpen = initialStatus !== null;
const idleMessage = "Confirm first, launch notes later.";
---

<WebsiteLayout>
	<div class="brand">
		<h1 class="wordmark">
			<span class="wordmark-name">waddle</span><span class="wordmark-dot" aria-hidden="true"
				>.</span
			><span class="wordmark-tld">social</span>
		</h1>
		<div class="brand-stack">
			<div class="logo-wrap">
				<button
					type="button"
					class="logo-button"
					data-toggle-waitlist
					aria-expanded={waitlistStartsOpen ? "true" : "false"}
					aria-controls="waitlist-panel"
					aria-label={waitlistStartsOpen ? "Close waitlist" : "Open waitlist"}
				>
					<img
						src="/logo.png"
						alt="Waddle"
						class="logo"
						width="1024"
						height="1024"
						decoding="async"
						fetchpriority="high"
					/>
				</button>
			</div>

			<div
				class:list={["waitlist", waitlistStartsOpen && "is-open"]}
				id="waitlist-panel"
				data-waitlist-panel
				aria-hidden={waitlistStartsOpen ? "false" : "true"}
			>
				<div class="waitlist-copy">
					<p class="waitlist-kicker">private beta, public signal</p>
					<p class="waitlist-teaser">
						Leave an address and we’ll send one confirmation note first. No public
						roster, no surprise blasts, and no “already on the list” tells.
					</p>
				</div>

				<div class="waitlist-control">
					<form
						id="waitlist-form"
						class="waitlist-form"
						method="post"
						action="/api/waitlist"
						autocomplete="on"
						aria-disabled="false"
						data-waitlist-form
					>
						<label class="sr-only" for="email">Email address</label>
						<input
							id="email"
							name="email"
							type="email"
							autocomplete="email"
							inputmode="email"
							placeholder="you@signal.example"
							required
						/>
						<button type="submit" class="waitlist-send" aria-label="Join waitlist">
							<img src="/waddle-mark.svg" alt="" width="32" height="32" />
						</button>
					</form>

					<p
						class="waitlist-status"
						data-waitlist-status
						data-state={initialStatus?.tone ?? "idle"}
						data-idle-message={idleMessage}
						data-pending-message={WAITLIST_PENDING_MESSAGE}
						data-success-message={WAITLIST_SUCCESS_MESSAGE}
						data-error-message={WAITLIST_RETRY_MESSAGE}
						aria-live="polite"
					>
						{initialStatus?.message ?? idleMessage}
					</p>

					<p class="waitlist-meta">
						One pending request per inbox. Confirmation required before activation.
						Every note carries its own unsubscribe link.
					</p>
				</div>
			</div>
		</div>
	</div>

	<script>
		const logoButton = document.querySelector<HTMLButtonElement>("[data-toggle-waitlist]");
		const panel = document.querySelector<HTMLElement>("[data-waitlist-panel]");
		const form = document.querySelector<HTMLFormElement>("[data-waitlist-form]");
		const emailInput = form?.querySelector<HTMLInputElement>('input[name="email"]');
		const submitButton = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
		const status = document.querySelector<HTMLElement>("[data-waitlist-status]");

		const setPanelOpen = (next: boolean) => {
			if (!logoButton || !panel) {
				return;
			}

			logoButton.setAttribute("aria-expanded", String(next));
			logoButton.setAttribute("aria-label", next ? "Close waitlist" : "Open waitlist");
			panel.setAttribute("aria-hidden", String(!next));
			panel.classList.toggle("is-open", next);
		};

		const setStatus = (tone: "idle" | "pending" | "success" | "error", message: string) => {
			if (!status) {
				return;
			}

			status.dataset.state = tone;
			status.textContent = message;
		};

		const setBusy = (busy: boolean) => {
			if (!form || !emailInput || !submitButton) {
				return;
			}

			form.setAttribute("aria-disabled", String(busy));
			form.dataset.busy = String(busy);
			emailInput.disabled = busy;
			submitButton.disabled = busy;
		};

		setPanelOpen(panel?.classList.contains("is-open") ?? false);

		logoButton?.addEventListener("click", () => {
			setPanelOpen(!(panel?.classList.contains("is-open") ?? false));
		});

		form?.addEventListener("submit", async (event) => {
			event.preventDefault();

			if (!form || !emailInput || !submitButton || !status) {
				return;
			}

			if (!form.reportValidity()) {
				return;
			}

			setPanelOpen(true);
			setBusy(true);
			setStatus("pending", status.dataset.pendingMessage ?? "Packing your confirmation note…");

			try {
				const response = await fetch(form.action, {
					method: "POST",
					headers: {
						Accept: "application/json",
					},
					body: new FormData(form),
				});

				const payload = (await response.json()) as {
					ok?: boolean;
					message?: string;
				};

				if (response.ok && payload.ok) {
					form.reset();
					setStatus(
						"success",
						payload.message ??
							status.dataset.successMessage ??
							"If that address can receive Waddle waitlist mail, you’ll get a link shortly.",
					);
					return;
				}

				setStatus(
					"error",
					payload.message ??
						status.dataset.errorMessage ??
						"Mail hiccup on our side. Try again in a minute.",
				);
			} catch {
				setStatus(
					"error",
					status.dataset.errorMessage ?? "Mail hiccup on our side. Try again in a minute.",
				);
			} finally {
				setBusy(false);
			}
		});
	</script>
</WebsiteLayout>
