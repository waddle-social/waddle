---
import penguins from "@waddle/design/assets/story-penguins.svg?url";
import mark from "@waddle/design/assets/waddle-mark.svg?url";
import namespaceLogo from "@waddle/design/assets/namespace-logo.svg?url";
import { css, cx } from "../../styled-system/css";
import { floe, polar, trio } from "../../styled-system/recipes";
import ThemeToggle from "../components/ThemeToggle.astro";
import WebsiteLayout from "../layouts/WebsiteLayout.astro";
import {
	WAITLIST_INVALID_MESSAGE,
	WAITLIST_PENDING_MESSAGE,
	WAITLIST_QUERY_KEY,
	WAITLIST_RETRY_MESSAGE,
	WAITLIST_SUCCESS_MESSAGE,
	WAITLIST_TURNSTILE_ACTION,
	WAITLIST_UNAVAILABLE_MESSAGE,
	WAITLIST_VERIFICATION_MESSAGE,
} from "../lib/waitlist/constants";
import { getWaitlistTurnstileSiteKey } from "../lib/waitlist/runtime";

const waitlistState = Astro.url.searchParams.get(WAITLIST_QUERY_KEY);
const turnstileSiteKey = getWaitlistTurnstileSiteKey();
const turnstileConfigured = turnstileSiteKey.length > 0;
const initialStatus =
	waitlistState === "submitted"
		? { tone: "success", message: WAITLIST_SUCCESS_MESSAGE }
		: waitlistState === "invalid"
			? { tone: "error", message: WAITLIST_INVALID_MESSAGE }
			: waitlistState === "verify"
				? { tone: "error", message: WAITLIST_VERIFICATION_MESSAGE }
				: waitlistState === "offline"
					? { tone: "error", message: WAITLIST_UNAVAILABLE_MESSAGE }
					: waitlistState === "retry"
						? { tone: "error", message: WAITLIST_RETRY_MESSAGE }
						: null;
const idleMessage = turnstileConfigured
	? "Confirm first, launch notes later."
	: WAITLIST_UNAVAILABLE_MESSAGE;

const facts = [
	"AGPL-3.0-or-later",
	"XMPP-native",
	"Rust server",
	"Web · Apple · Android · Linux",
	"Docs CC BY-SA 4.0",
];
const maturity = [
	{
		label: "Production",
		tone: css({ bg: "success.subtle", color: "success.text" }),
		items: ["Room messaging", "Direct messages", "Durable history", "Reactions"],
	},
	{
		label: "Beta",
		tone: css({ bg: "info.subtle", color: "info.text" }),
		items: [
			"Unread and read state",
			"Push notifications",
			"Search",
			"File sharing",
			"Threads and replies",
			"Audio and video calls",
			"Reconnect and resume",
			"Spaces and administration",
		],
	},
	{
		label: "Experimental",
		tone: css({ bg: "warning.subtle", color: "warning.text" }),
		items: ["Moderation", "Community feed and stories"],
	},
];
const makers = [
	{ flag: "🇩🇪", country: "Germany", login: "icepuma" },
	{ flag: "🏴󠁧󠁢󠁳󠁣󠁴󠁿", country: "Scotland", login: "rawkode" },
	{ flag: "🇳🇴", country: "Norway", login: "randax" },
];

const container = css({
	width: "100%",
	maxWidth: "1200px",
	mx: "auto",
	boxSizing: "border-box",
	px: "gutter",
});
const link = css({
	color: "halo",
	textDecoration: "underline",
	textUnderlineOffset: "3px",
	_hover: { color: "fg" },
});
const sponsor = css({
	flexDirection: "row",
	flexWrap: "wrap",
	alignItems: "center",
	gap: "5",
	p: "{spacing.4} {spacing.6} {spacing.4} {spacing.4}",
	borderRadius: "card",
	minWidth: 0,
});
const sponsorArt = css({
	display: "block",
	width: "168px",
	height: "64px",
	flex: "none",
	borderRadius: "control",
});
const sponsorText = css({
	display: "flex",
	flexDirection: "column",
	alignItems: "flex-start",
	gap: "0.5",
	textAlign: "left",
	minWidth: 0,
	flex: "1 1 180px",
	"& b": { font: "700 16px/1.3 {fonts.display}", color: "fg" },
	"& span": { textStyle: "caption", color: "fg.muted" },
});
---

<WebsiteLayout>
	<div
		class={cx(
			polar(),
			css({ minHeight: "100dvh", display: "flex", flexDirection: "column", fontFamily: "body" }),
		)}
	>
		<header
			class={cx(
				container,
				css({
					pt: "6",
					display: "flex",
					alignItems: "center",
					justifyContent: "space-between",
					gap: "4",
					flexWrap: "wrap",
				}),
			)}
		>
			<a
				href="/"
				class={css({
					display: "flex",
					alignItems: "center",
					gap: "2.5",
					color: "fg",
					textDecoration: "none",
				})}
			>
				<img
					src={mark}
					alt=""
					width="32"
					height="32"
					class={css({ width: "32px", height: "32px", borderRadius: "pill", bg: "belly", p: "1" })}
				/>
				<span
					class={css({
						fontFamily: "display",
						fontWeight: 700,
						fontSize: "lg",
						letterSpacing: "-0.01em",
					})}>waddle.social</span
				>
			</a>
			<nav
				aria-label="Site"
				class={css({
					display: "flex",
					alignItems: "center",
					columnGap: "5",
					rowGap: "2",
					fontSize: "sm",
					flexWrap: "wrap",
				})}
			>
				<a class={link} href="https://github.com/waddle-social/waddle" rel="noreferrer" target="_blank"
					>Source on GitHub</a
				>
				<a class={link} href="#proof-h">How it works</a>
				<ThemeToggle placement="inline" />
			</nav>
		</header>

		<main
			class={cx(
				container,
				css({
					flex: 1,
					pt: { base: "12", _narrow: "10" },
					pb: "16",
					display: "flex",
					flexWrap: "wrap",
					alignItems: "center",
					gap: "12",
				}),
			)}
		>
			<section
				aria-labelledby="hero-h"
				class={css({
					flex: "1 1 440px",
					minWidth: 0,
					display: "flex",
					flexDirection: "column",
					gap: "6",
				})}
			>
				<span
					class={css({
						display: "inline-flex",
						alignItems: "center",
						gap: "2.5",
						textStyle: "eyebrow",
						color: "halo",
					})}
					><span class={trio({ live: true })} aria-hidden="true"><i></i><i></i><i></i></span>Waitlist
					open · built on XMPP</span
				>
				<h1
					id="hero-h"
					class={css({
						m: 0,
						fontFamily: "display",
						fontSize: "clamp(2.75rem, 1.4rem + 4.2vw, 4.75rem)",
						lineHeight: 0.96,
						fontWeight: 800,
						fontStretch: "90%",
						letterSpacing: "-0.04em",
						textWrap: "balance",
						overflowWrap: "break-word",
					})}
				>
					Social chat that's yours by default.
				</h1>
				<p
					class={css({
						m: 0,
						fontSize: "lg",
						lineHeight: 1.55,
						color: "fg.muted",
						maxWidth: "34em",
					})}
				>
					Open-source rooms, huddles and discussions on an open standard. Your account, your
					server, your people.
				</p>

				<form
					id="waitlist-form"
					method="post"
					action="/api/waitlist"
					autocomplete="on"
					novalidate
					aria-disabled={turnstileConfigured ? "false" : "true"}
					data-waitlist-form
					data-state="idle"
					data-turnstile-action={WAITLIST_TURNSTILE_ACTION}
					data-turnstile-configured={turnstileConfigured ? "true" : "false"}
					data-turnstile-site-key={turnstileSiteKey}
					class={css({ display: "flex", flexDirection: "column", gap: "2.5", maxWidth: "460px" })}
				>
					<label for="waitlist-email" class={css({ fontSize: "xs", fontWeight: 600 })}
						>Get on the waitlist</label
					>
					<div
						class={css({
							display: "flex",
							gap: "2",
							p: "1.5",
							borderRadius: "pill",
							bg: "surface",
							border: "1px solid {colors.border}",
							transition: "box-shadow {durations.base} {easings.out}",
							_focusWithin: {
								outline: "3px solid {colors.focus}",
								outlineOffset: "1px",
								boxShadow: "0 0 0 6px color-mix(in srgb, {colors.focus} 18%, transparent)",
							},
							"@media (forced-colors: active)": { border: "1px solid CanvasText" },
						})}
					>
						<input
							id="waitlist-email"
							name="email"
							type="email"
							autocomplete="email"
							inputmode="email"
							placeholder="you@yourdomain.com"
							required
							aria-describedby="waitlist-status"
							class={css({
								flex: 1,
								minWidth: 0,
								height: "44px",
								border: 0,
								bg: "transparent",
								color: "fg",
								textStyle: "input",
								px: "14px",
								outline: "none",
								_placeholder: { color: "fg.soft" },
								_disabled: { cursor: "not-allowed" },
							})}
						/>
						<button
							type="submit"
							aria-label="Join waitlist"
							disabled={!turnstileConfigured}
							class={css({
								width: "44px",
								height: "44px",
								flex: "none",
								border: 0,
								borderRadius: "pill",
								bg: "action",
								color: "action.fg",
								bgImage: "{gradients.sheen}",
								display: "inline-flex",
								alignItems: "center",
								justifyContent: "center",
								cursor: "pointer",
								transition:
									"background-color {durations.fast} {easings.out}, scale {durations.base} {easings.spring.snappy}",
								_hover: { bg: "action.hover" },
								_active: { scale: "var(--wd-press)" },
								_disabled: { bg: "surface.2", color: "fg.soft", bgImage: "none", cursor: "not-allowed" },
								"[data-state=submitting] &": { cursor: "progress" },
							})}
						>
							<svg
								aria-hidden="true"
								viewBox="0 0 24 24"
								width="22"
								height="22"
								fill="none"
								stroke="currentColor"
								stroke-width="1.75"
								stroke-linecap="round"
								stroke-linejoin="round"
								><path d="M8 4h8a5 5 0 0 1 5 5v5a5 5 0 0 1-5 5h-6l-5 2v-3a4.5 4.5 0 0 1-2-4V9a5 5 0 0 1 5-5Z"
								></path><path d="M8.5 10h.01M15.5 10h.01"></path><path d="m10 13 2 2 2-2Z"></path></svg
							>
						</button>
					</div>
					<input type="hidden" name="cf-turnstile-response" value="" />
					<div data-waitlist-turnstile class={css({ _empty: { display: "none" } })}></div>
					<p
						id="waitlist-status"
						role="status"
						data-waitlist-status
						data-state={initialStatus?.tone ?? "idle"}
						data-idle-message={idleMessage}
						data-pending-message={WAITLIST_PENDING_MESSAGE}
						data-success-message={WAITLIST_SUCCESS_MESSAGE}
						data-error-message={WAITLIST_RETRY_MESSAGE}
						data-invalid-message={WAITLIST_INVALID_MESSAGE}
						data-unavailable-message={WAITLIST_UNAVAILABLE_MESSAGE}
						data-verification-message={WAITLIST_VERIFICATION_MESSAGE}
						class={css({
							m: 0,
							ml: "14px",
							fontSize: "xs",
							color: "fg.muted",
							"&[data-state=error]": { color: "danger.text" },
							"&[data-state=success]": { color: "action.text" },
						})}
					>
						{initialStatus?.message ?? idleMessage}
					</p>
				</form>
			</section>

			<section
				class={css({ flex: "1 1 480px", minWidth: 0, display: "flex", justifyContent: "center" })}
			>
				<img
					src={penguins}
					alt="Three penguins in scarves sharing hot cocoa on an ice floe shaped like a speech bubble"
					width="560"
					height="560"
					fetchpriority="high"
					class={css({
						width: "100%",
						maxWidth: "560px",
						height: "auto",
						aspectRatio: "1 / 1",
						objectFit: "cover",
						borderRadius: { base: "40px", _narrow: "sheet" },
						boxShadow: "{shadows.elev.3}, 0 0 0 1px color-mix(in srgb, {colors.halo} 18%, transparent)",
					})}
				/>
			</section>
		</main>

		<section
			aria-labelledby="proof-h"
			class={cx(
				container,
				css({ pb: "72px", display: "flex", flexDirection: "column", gap: "8", scrollMarginTop: "6" }),
			)}
		>
			<ul
				aria-label="Facts"
				class={css({
					m: 0,
					p: 0,
					listStyle: "none",
					display: "flex",
					flexWrap: "wrap",
					gap: "2.5",
					font: "400 14px/1 {fonts.mono}",
					color: "fg.muted",
					"& li": {
						py: "2",
						px: "14px",
						borderRadius: "pill",
						bg: "color-mix(in srgb, {colors.surface} 70%, transparent)",
						border: "1px solid {colors.border.soft}",
					},
				})}
			>
				{facts.map((fact) => <li>{fact}</li>)}
			</ul>
			<div
				class={css({
					display: "flex",
					alignItems: "end",
					justifyContent: "space-between",
					gap: "6",
					flexWrap: "wrap",
				})}
			>
				<h2 id="proof-h" class={css({ m: 0, textStyle: "headline" })}>What you get today</h2>
				<p class={css({ m: 0, maxWidth: "32em", color: "fg.muted" })}>
					Straight from the server's capability list. Federation is not supported yet.
				</p>
			</div>
			<div
				class={css({
					display: "grid",
					gridTemplateColumns: { base: "repeat(3, minmax(0, 1fr))", _narrow: "minmax(0, 1fr)" },
					gap: "4",
					alignItems: "start",
				})}
			>
				{
					maturity.map((group) => (
						<div class={cx(floe(), css({ gap: "3" }))}>
							<span
								class={cx(
									group.tone,
									css({
										alignSelf: "flex-start",
										display: "inline-flex",
										alignItems: "center",
										height: "26px",
										px: "3",
										borderRadius: "pill",
										textStyle: "tag",
									}),
								)}
							>
								{group.label}
							</span>
							<ul
								class={css({
									m: 0,
									p: 0,
									listStyle: "none",
									display: "flex",
									flexDirection: "column",
									gap: "2",
									fontSize: "md",
								})}
							>
								{group.items.map((item) => <li>{item}</li>)}
							</ul>
						</div>
					))
				}
			</div>
		</section>

		<section
			aria-labelledby="sponsors-h"
			class={cx(
				container,
				css({
					pb: "72px",
					display: "flex",
					flexDirection: "column",
					alignItems: "center",
					gap: "5",
					textAlign: "center",
				}),
			)}
		>
			<h2 id="sponsors-h" class={css({ m: 0, textStyle: "eyebrow", fontFamily: "body" })}>
				Supported by
			</h2>
			<div
				class={css({
					display: "flex",
					flexWrap: "wrap",
					justifyContent: "center",
					gap: "4",
					width: "100%",
					"& > a": { flex: "0 1 auto", maxWidth: "100%" },
				})}
			>
				<a
					href="https://www.hetzner.com/?mtm_campaign=waddle-social&mtm_medium=referral&mtm_content=sponsoring_link"
					rel="noreferrer"
					target="_blank"
					class={cx(floe(), sponsor)}
				>
					<img
						src="/hetzner-logo.jpg"
						alt="Hetzner"
						width="168"
						height="64"
						loading="lazy"
						decoding="async"
						class={cx(sponsorArt, css({ objectFit: "cover" }))}
					/>
					<span class={sponsorText}>
						<b>Infrastructure by Hetzner</b>
						<span>Servers and hosting for waddle.social</span>
					</span>
				</a>
				<a href="https://namespace.so" rel="noreferrer" target="_blank" class={cx(floe(), sponsor)}>
					<span
						class={cx(
							sponsorArt,
							css({
								display: "flex",
								alignItems: "center",
								justifyContent: "center",
								gap: "2.5",
								boxSizing: "border-box",
								bg: "surface.2",
								border: "1px solid {colors.border}",
								color: "fg",
								font: "700 17px/1 {fonts.display}",
								letterSpacing: "-0.01em",
							}),
						)}
						><img src={namespaceLogo} alt="" width="36" height="36" />Namespace</span
					>
					<span class={sponsorText}>
						<b>CI by Namespace Labs</b>
						<span>Build runners and caches for Waddle's CI</span>
					</span>
				</a>
			</div>
		</section>

		<footer
			class={cx(
				container,
				css({
					pt: "5",
					pb: "28px",
					borderTop: "1px solid {colors.border.soft}",
					display: "flex",
					justifyContent: "space-between",
					columnGap: "3",
					rowGap: "2",
					flexWrap: "wrap",
					fontSize: "xs",
					color: "fg.muted",
				}),
			)}
		>
			<span>Waddle is open source.</span>
			<span class={css({ display: "flex", flexWrap: "wrap", alignItems: "center", gap: "2" })}>
				<span>
					Made with love in
					<span aria-label="Germany, Scotland, and Norway" role="group">
						{
							makers.map((maker) => (
								<a
									href={`https://github.com/${maker.login}`}
									rel="noreferrer"
									target="_blank"
									aria-label={`${maker.country}: ${maker.login} on GitHub`}
									class={css({ textDecoration: "none", px: "0.5" })}
								>
									<span aria-hidden="true">{maker.flag}</span>
								</a>
							))
						}
					</span>
				</span>
				<span aria-hidden="true">·</span>
				<a class={link} href="https://bsky.app/profile/waddle.social" rel="noreferrer" target="_blank"
					>Bluesky</a
				>
				<span aria-hidden="true">·</span>
				<span class={css({ fontFamily: "mono" })}>humans@waddle.social</span>
			</span>
		</footer>
	</div>

	<script>
		const TURNSTILE_API_SRC = "https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit";
		const form = document.querySelector<HTMLFormElement>("[data-waitlist-form]");
		const emailInput = form?.querySelector<HTMLInputElement>('input[name="email"]');
		const submitButton = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
		const turnstileContainer = form?.querySelector<HTMLElement>("[data-waitlist-turnstile]");
		const turnstileResponseInput = form?.querySelector<HTMLInputElement>(
			'input[name="cf-turnstile-response"]',
		);
		const status = document.querySelector<HTMLElement>("[data-waitlist-status]");
		const turnstileConfigured = form?.dataset.turnstileConfigured === "true";
		const turnstileSiteKey = form?.dataset.turnstileSiteKey?.trim() ?? "";
		const turnstileAction = form?.dataset.turnstileAction ?? "";
		const unavailableMessage =
			status?.dataset.unavailableMessage ??
			"Waitlist verification is offline right now. Try again in a minute.";
		const verificationMessage =
			status?.dataset.verificationMessage ??
			"Complete the quick human check, then try again.";
		const invalidMessage = status?.dataset.invalidMessage ?? "Add a valid email address.";
		let widgetId: string | null = null;
		let turnstileScriptPromise: Promise<boolean> | null = null;
		let turnstileRenderPromise: Promise<void> | null = null;

		type FormState = "idle" | "verifying" | "ready" | "submitting";

		const setFormState = (next: FormState) => {
			if (!form) {
				return;
			}
			form.dataset.state = next;
		};

		const setStatus = (tone: "idle" | "pending" | "success" | "error", message: string) => {
			if (!status) {
				return;
			}

			status.dataset.state = tone;
			status.textContent = message;
		};

		const setBusy = (busy: boolean) => {
			if (!form || !emailInput || !submitButton) {
				return;
			}

			form.setAttribute("aria-disabled", String(busy));
			form.setAttribute("aria-busy", String(busy));
			emailInput.disabled = busy;
			submitButton.disabled = busy;
		};

		const loadTurnstileScript = () => {
			if (window.turnstile) {
				return Promise.resolve(true);
			}

			if (turnstileScriptPromise) {
				return turnstileScriptPromise;
			}

			turnstileScriptPromise = new Promise<boolean>((resolve) => {
				const script = document.createElement("script");
				script.src = TURNSTILE_API_SRC;
				script.async = true;
				script.defer = true;
				script.dataset.turnstileScript = "true";
				script.addEventListener(
					"load",
					() => {
						resolve(Boolean(window.turnstile));
					},
					{ once: true },
				);
				script.addEventListener(
					"error",
					() => {
						turnstileScriptPromise = null;
						script.remove();
						resolve(false);
					},
					{ once: true },
				);
				document.head.appendChild(script);
			});

			return turnstileScriptPromise;
		};

		const resetTurnstile = () => {
			if (turnstileResponseInput) {
				turnstileResponseInput.value = "";
			}

			if (widgetId && window.turnstile) {
				window.turnstile.reset(widgetId);
			}
		};

		const renderTurnstile = async () => {
			if (!turnstileConfigured || !turnstileContainer || !turnstileResponseInput || !status) {
				return;
			}

			if (turnstileRenderPromise) {
				return turnstileRenderPromise;
			}

			turnstileRenderPromise = (async () => {
				const ready = await loadTurnstileScript();
				if (!ready || !window.turnstile) {
					setFormState("idle");
					setStatus("error", unavailableMessage);
					return;
				}

				if (widgetId) {
					window.turnstile.remove(widgetId);
					widgetId = null;
				}

				turnstileResponseInput.value = "";
				setFormState("verifying");
				widgetId = window.turnstile.render(turnstileContainer, {
					sitekey: turnstileSiteKey,
					action: turnstileAction,
					// Stay out of sight unless Cloudflare needs the visitor to interact; we run the check ourselves.
					appearance: "interaction-only",
					size: "flexible",
					execution: "execute",
					callback: (token) => {
						turnstileResponseInput.value = token;
						setFormState("ready");
						if (status.dataset.state === "error") {
							setStatus(
								"idle",
								status.dataset.idleMessage ?? "Confirm first, launch notes later.",
							);
						}
					},
					"error-callback": () => {
						turnstileResponseInput.value = "";
						setFormState("idle");
						setStatus("error", unavailableMessage);
					},
					"expired-callback": () => {
						turnstileResponseInput.value = "";
						setFormState("idle");
						setStatus("error", verificationMessage);
						resetTurnstile();
					},
				});

				if (widgetId) {
					window.turnstile.execute(widgetId);
				}
			})().finally(() => {
				turnstileRenderPromise = null;
			});

			return turnstileRenderPromise;
		};

		// The challenge (and its script) loads only once someone reaches for the form.
		const ensureTurnstileReady = async () => {
			if (!turnstileConfigured) {
				return;
			}

			if (turnstileResponseInput?.value) {
				setFormState("ready");
				return;
			}

			if (!widgetId) {
				await renderTurnstile();
				return;
			}

			if (form?.dataset.state !== "verifying") {
				setFormState("verifying");
				resetTurnstile();
				if (widgetId && window.turnstile) {
					window.turnstile.execute(widgetId);
				}
			}
		};

		// Prepare the invisible check on load so a fast first submit already has a token.
		void ensureTurnstileReady();

		emailInput?.addEventListener("input", () => {
			emailInput.removeAttribute("aria-invalid");
		});

		window.addEventListener("waddle:theme-change", () => {
			if (!turnstileConfigured || !widgetId) {
				return;
			}

			void renderTurnstile();
		});

		form?.addEventListener("submit", async (event) => {
			event.preventDefault();

			if (!form || !emailInput || !submitButton || !status) {
				return;
			}

			if (!emailInput.checkValidity()) {
				emailInput.setAttribute("aria-invalid", "true");
				emailInput.focus();
				setStatus("error", invalidMessage);
				return;
			}

			if (!turnstileConfigured) {
				setStatus("error", unavailableMessage);
				return;
			}

			if (!turnstileResponseInput?.value) {
				await ensureTurnstileReady();
				setStatus("error", verificationMessage);
				return;
			}

			const requestBody = new FormData(form);
			setBusy(true);
			setFormState("submitting");
			setStatus("pending", status.dataset.pendingMessage ?? "Packing your confirmation note…");

			try {
				const response = await fetch(form.action, {
					method: "POST",
					headers: {
						Accept: "application/json",
					},
					body: requestBody,
				});

				const payload = (await response.json()) as {
					ok?: boolean;
					message?: string;
				};

				if (response.ok && payload.ok) {
					form.reset();
					resetTurnstile();
					setFormState("idle");
					setStatus(
						"success",
						payload.message ??
							status.dataset.successMessage ??
							"If that address can receive Waddle waitlist mail, you’ll get a link shortly.",
					);
					return;
				}

				resetTurnstile();
				setStatus(
					"error",
					payload.message ??
						status.dataset.errorMessage ??
						"Mail hiccup on our side. Try again in a minute.",
				);
				setFormState("idle");
				void ensureTurnstileReady();
			} catch {
				resetTurnstile();
				setStatus(
					"error",
					status.dataset.errorMessage ?? "Mail hiccup on our side. Try again in a minute.",
				);
				setFormState("idle");
				void ensureTurnstileReady();
			} finally {
				setBusy(false);
			}
		});
	</script>
</WebsiteLayout>
