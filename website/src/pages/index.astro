---
import WebsiteLayout from "../layouts/WebsiteLayout.astro";
import {
	WAITLIST_INVALID_MESSAGE,
	WAITLIST_PENDING_MESSAGE,
	WAITLIST_QUERY_KEY,
	WAITLIST_RETRY_MESSAGE,
	WAITLIST_SUCCESS_MESSAGE,
	WAITLIST_TURNSTILE_ACTION,
	WAITLIST_UNAVAILABLE_MESSAGE,
	WAITLIST_VERIFICATION_MESSAGE,
} from "../lib/waitlist/constants";
import { getWaitlistTurnstileSiteKey } from "../lib/waitlist/runtime";

const waitlistState = Astro.url.searchParams.get(WAITLIST_QUERY_KEY);
const turnstileSiteKey = getWaitlistTurnstileSiteKey();
const turnstileConfigured = turnstileSiteKey.length > 0;
const initialStatus =
	waitlistState === "submitted"
		? { tone: "success", message: WAITLIST_SUCCESS_MESSAGE }
		: waitlistState === "invalid"
			? { tone: "error", message: WAITLIST_INVALID_MESSAGE }
			: waitlistState === "verify"
				? { tone: "error", message: WAITLIST_VERIFICATION_MESSAGE }
				: waitlistState === "offline"
					? { tone: "error", message: WAITLIST_UNAVAILABLE_MESSAGE }
					: waitlistState === "retry"
						? { tone: "error", message: WAITLIST_RETRY_MESSAGE }
						: null;
const waitlistStartsOpen = initialStatus !== null;
const idleMessage = turnstileConfigured
	? "Confirm first, launch notes later."
	: WAITLIST_UNAVAILABLE_MESSAGE;
---

<WebsiteLayout>
	<div class="brand">
		<h1 class="wordmark">
			<span class="wordmark-name">waddle</span><span class="wordmark-dot" aria-hidden="true"
				>.</span
			><span class="wordmark-tld">social</span>
		</h1>
		<div class="brand-stack">
			<div class="logo-wrap">
				<button
					type="button"
					class="logo-button"
					data-toggle-waitlist
					aria-expanded={waitlistStartsOpen ? "true" : "false"}
					aria-controls="waitlist-panel"
					aria-label={waitlistStartsOpen ? "Close waitlist" : "Open waitlist"}
				>
					<img
						src="/logo.png"
						alt="Waddle"
						class="logo"
						width="1024"
						height="1024"
						decoding="async"
						fetchpriority="high"
					/>
				</button>
			</div>

			<div
				class:list={["waitlist", waitlistStartsOpen && "is-open"]}
				id="waitlist-panel"
				data-waitlist-panel
				aria-hidden={waitlistStartsOpen ? "false" : "true"}
			>
				<div class="waitlist-control">
					<form
						id="waitlist-form"
						class="waitlist-form"
						method="post"
						action="/api/waitlist"
						autocomplete="on"
						aria-disabled={turnstileConfigured ? "false" : "true"}
						data-waitlist-form
						data-turnstile-action={WAITLIST_TURNSTILE_ACTION}
						data-turnstile-configured={turnstileConfigured ? "true" : "false"}
						data-turnstile-site-key={turnstileSiteKey}
					>
						<div class="waitlist-form-main">
							<label class="sr-only" for="email">Email address</label>
							<input
								id="email"
								name="email"
								type="email"
								autocomplete="email"
								inputmode="email"
								placeholder="you@signal.example"
								required
							/>
							<button
								type="submit"
								class="waitlist-send"
								aria-label="Join waitlist"
								disabled={!turnstileConfigured}
							>
								<img src="/waddle-mark.svg" alt="" width="32" height="32" />
							</button>
						</div>
						<input type="hidden" name="cf-turnstile-response" value="" data-turnstile-response />
						{
							turnstileConfigured && (
								<div class="waitlist-turnstile-row">
									<div class="waitlist-turnstile" data-waitlist-turnstile></div>
								</div>
							)
						}
					</form>

					<p
						class="waitlist-status"
						data-waitlist-status
						data-state={initialStatus?.tone ?? "idle"}
						data-idle-message={idleMessage}
						data-pending-message={WAITLIST_PENDING_MESSAGE}
						data-success-message={WAITLIST_SUCCESS_MESSAGE}
						data-error-message={WAITLIST_RETRY_MESSAGE}
						data-unavailable-message={WAITLIST_UNAVAILABLE_MESSAGE}
						data-verification-message={WAITLIST_VERIFICATION_MESSAGE}
						aria-live="polite"
					>
						{initialStatus?.message ?? idleMessage}
					</p>

					<p class="waitlist-meta">
						One pending request per inbox. Confirmation required before activation.
						Every note carries its own unsubscribe link.
					</p>
				</div>
			</div>
		</div>
	</div>

	<script is:inline>
		window.waddleTurnstileOnLoad = () => {
			window.dispatchEvent(new Event("waddle:turnstile-ready"));
		};
	</script>
	<script
		is:inline
		src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit&onload=waddleTurnstileOnLoad"
	></script>

	<script>
		const logoButton = document.querySelector<HTMLButtonElement>("[data-toggle-waitlist]");
		const panel = document.querySelector<HTMLElement>("[data-waitlist-panel]");
		const form = document.querySelector<HTMLFormElement>("[data-waitlist-form]");
		const emailInput = form?.querySelector<HTMLInputElement>('input[name="email"]');
		const submitButton = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
		const turnstileContainer = form?.querySelector<HTMLElement>("[data-waitlist-turnstile]");
		const turnstileResponseInput = form?.querySelector<HTMLInputElement>(
			'input[name="cf-turnstile-response"]',
		);
		const status = document.querySelector<HTMLElement>("[data-waitlist-status]");
		const turnstileConfigured = form?.dataset.turnstileConfigured === "true";
		const turnstileSiteKey = form?.dataset.turnstileSiteKey?.trim() ?? "";
		const turnstileAction = form?.dataset.turnstileAction ?? "";
		const unavailableMessage =
			status?.dataset.unavailableMessage ??
			"Waitlist verification is offline right now. Try again in a minute.";
		const verificationMessage =
			status?.dataset.verificationMessage ??
			"Complete the quick human check, then try again.";
		let widgetId: string | null = null;
		let turnstileRenderPromise: Promise<void> | null = null;

		const setPanelOpen = (next: boolean) => {
			if (!logoButton || !panel) {
				return;
			}

			logoButton.setAttribute("aria-expanded", String(next));
			logoButton.setAttribute("aria-label", next ? "Close waitlist" : "Open waitlist");
			panel.setAttribute("aria-hidden", String(!next));
			panel.classList.toggle("is-open", next);
		};

		const setStatus = (tone: "idle" | "pending" | "success" | "error", message: string) => {
			if (!status) {
				return;
			}

			status.dataset.state = tone;
			status.textContent = message;
		};

		const setBusy = (busy: boolean) => {
			if (!form || !emailInput || !submitButton) {
				return;
			}

			form.setAttribute("aria-disabled", String(busy));
			form.dataset.busy = String(busy);
			emailInput.disabled = busy;
			submitButton.disabled = busy;
		};

		const waitForTurnstile = async () => {
			if (window.turnstile) {
				return true;
			}

			return await new Promise<boolean>((resolve) => {
				const onReady = () => {
					window.clearTimeout(timeoutId);
					resolve(Boolean(window.turnstile));
				};
				const timeoutId = window.setTimeout(() => {
					window.removeEventListener("waddle:turnstile-ready", onReady);
					resolve(false);
				}, 4000);

				window.addEventListener("waddle:turnstile-ready", onReady, { once: true });
			});
		};

		const resetTurnstile = () => {
			if (turnstileResponseInput) {
				turnstileResponseInput.value = "";
			}

			if (widgetId && window.turnstile) {
				window.turnstile.reset(widgetId);
			}
		};

		const renderTurnstile = async () => {
			if (!turnstileConfigured || !turnstileContainer || !turnstileResponseInput || !status) {
				return;
			}

			if (turnstileRenderPromise) {
				return turnstileRenderPromise;
			}

			turnstileRenderPromise = (async () => {
				const ready = await waitForTurnstile();
				if (!ready || !window.turnstile) {
					setStatus("error", unavailableMessage);
					return;
				}

				if (widgetId) {
					window.turnstile.remove(widgetId);
					widgetId = null;
				}

				turnstileResponseInput.value = "";
				widgetId = window.turnstile.render(turnstileContainer, {
					sitekey: turnstileSiteKey,
					action: turnstileAction,
					size: "flexible",
					theme: document.documentElement.dataset.theme === "light" ? "light" : "dark",
					callback: (token) => {
						turnstileResponseInput.value = token;
						if (status.dataset.state === "error") {
							setStatus("idle", status.dataset.idleMessage ?? "Confirm first, launch notes later.");
						}
					},
					"error-callback": () => {
						turnstileResponseInput.value = "";
						setStatus("error", unavailableMessage);
					},
					"expired-callback": () => {
						turnstileResponseInput.value = "";
						setStatus("error", verificationMessage);
						resetTurnstile();
					},
				});
			})().finally(() => {
				turnstileRenderPromise = null;
			});

			return turnstileRenderPromise;
		};

		setPanelOpen(panel?.classList.contains("is-open") ?? false);
		if (turnstileConfigured) {
			void renderTurnstile();
		}

		logoButton?.addEventListener("click", () => {
			setPanelOpen(!(panel?.classList.contains("is-open") ?? false));
		});

		window.addEventListener("waddle:theme-change", () => {
			if (!turnstileConfigured) {
				return;
			}

			void renderTurnstile();
		});

		form?.addEventListener("submit", async (event) => {
			event.preventDefault();

			if (!form || !emailInput || !submitButton || !status) {
				return;
			}

			if (!form.reportValidity()) {
				return;
			}

			if (!turnstileConfigured) {
				setPanelOpen(true);
				setStatus("error", unavailableMessage);
				return;
			}

			if (!turnstileResponseInput?.value) {
				setPanelOpen(true);
				setStatus("error", verificationMessage);
				return;
			}

			const requestBody = new FormData(form);
			setPanelOpen(true);
			setBusy(true);
			setStatus("pending", status.dataset.pendingMessage ?? "Packing your confirmation note…");

			try {
				const response = await fetch(form.action, {
					method: "POST",
					headers: {
						Accept: "application/json",
					},
					body: requestBody,
				});

				const payload = (await response.json()) as {
					ok?: boolean;
					message?: string;
				};

				if (response.ok && payload.ok) {
					form.reset();
					resetTurnstile();
					setStatus(
						"success",
						payload.message ??
							status.dataset.successMessage ??
							"If that address can receive Waddle waitlist mail, you’ll get a link shortly.",
					);
					return;
				}

				resetTurnstile();
				setStatus(
					"error",
					payload.message ??
						status.dataset.errorMessage ??
						"Mail hiccup on our side. Try again in a minute.",
				);
			} catch {
				resetTurnstile();
				setStatus(
					"error",
					status.dataset.errorMessage ?? "Mail hiccup on our side. Try again in a minute.",
				);
			} finally {
				setBusy(false);
			}
		});
	</script>
</WebsiteLayout>
