---
import WebsiteLayout from "../../layouts/WebsiteLayout.astro";
import { getWaitlistRuntime } from "../../lib/waitlist/runtime";
import { inspectUnsubscribeToken } from "../../lib/waitlist/service";

const result = Astro.url.searchParams.get("result");
const token = Astro.url.searchParams.get("token");

let mode: "ready" | "success" | "stale" = "stale";

if (result === "removed") {
	mode = "success";
} else {
	const { store } = getWaitlistRuntime();
	mode = (await inspectUnsubscribeToken(token, store)) === "ready" ? "ready" : "stale";
}
---

<WebsiteLayout
	title="Cancel Waitlist Request"
	description="Cancel a pending Waddle waitlist request."
	canonicalPath="/waitlist/unsubscribe"
	footerMode="stacked"
>
	<section class="action-shell">
		<div class:list={["action-card", mode === "success" && "action-card--quiet"]}>
			<p class="action-kicker">request control</p>
			<h1 class="action-title">
				{
					mode === "ready"
						? "Cancel this waitlist request?"
						: mode === "success"
							? "Request canceled."
							: "That link is no longer active."
				}
			</h1>
			<p class="action-copy">
				{
					mode === "ready"
						? "This removes the pending request entirely. If you ever want back in, you can join again from scratch."
						: mode === "success"
							? "The pending request is gone. Nothing else will be sent from this signup."
							: "Cancel links are single-use. If you want a fresh invite later, join again from the homepage."
				}
			</p>

			{
				mode === "ready" ? (
					<form method="post" action="/api/waitlist/unsubscribe" class="action-form">
						<input type="hidden" name="token" value={token ?? ""} />
						<div class="action-actions">
							<button type="submit" class="action-button action-button--ghost">
								cancel this request
							</button>
							<a href="/" class="action-link">
								keep it instead
							</a>
						</div>
					</form>
				) : (
					<div class="action-actions">
						<a href="/" class="action-button action-button--ghost">
							return to homepage
						</a>
					</div>
				)
			}
		</div>
	</section>
</WebsiteLayout>
