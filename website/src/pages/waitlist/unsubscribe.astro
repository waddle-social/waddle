---
import { css, cx } from "../../../styled-system/css";
import { btn } from "../../../styled-system/recipes";
import ActionCard from "../../components/ActionCard.astro";
import WebsiteLayout from "../../layouts/WebsiteLayout.astro";
import { getWaitlistRuntime } from "../../lib/waitlist/runtime";
import { inspectUnsubscribeToken } from "../../lib/waitlist/service";

const result = Astro.url.searchParams.get("result");
const token = Astro.url.searchParams.get("token");

let mode: "ready" | "success" | "stale" = "stale";

if (result === "removed") {
	mode = "success";
} else {
	const { store } = getWaitlistRuntime();
	mode = (await inspectUnsubscribeToken(token, store)) === "ready" ? "ready" : "stale";
}

const heading = {
	ready: "Cancel this waitlist request?",
	success: "Request canceled.",
	stale: "That link is no longer active.",
}[mode];
const copy = {
	ready: "Waddle will stop sending notes to this inbox for this signup.",
	success: "Nothing else will be sent from this signup.",
	stale: "Cancel links are single-use. If you still get notes, use the link in the newest one.",
}[mode];
const wide = css({ height: "44px", minHeight: "44px", justifyContent: "center", textDecoration: "none" });
const half = css({ flex: "1 1 160px" });
---

<WebsiteLayout
	title="Cancel Waitlist Request"
	description="Cancel a pending Waddle waitlist request."
	canonicalPath="/waitlist/unsubscribe"
>
	<ActionCard heading={heading}>
		{copy}

		{
			mode === "ready" ? (
				<form
					slot="actions"
					method="post"
					action="/api/waitlist/unsubscribe"
					class={css({ display: "flex", gap: "2", pt: "2", flexWrap: "wrap" })}
				>
					<input type="hidden" name="token" value={token ?? ""} />
					<button type="submit" class={cx(btn({ variant: "danger" }), wide, half)}>
						Cancel this request
					</button>
					<a href="/" class={cx(btn(), wide, half)}>
						Keep it instead
					</a>
				</form>
			) : (
				<a slot="actions" href="/" class={cx(btn(), wide, css({ mt: "2" }))}>
					Return to homepage
				</a>
			)
		}
	</ActionCard>
</WebsiteLayout>
