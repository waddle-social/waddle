---
// The celestial theme toggle: one button holds the sun (daylight) and the moon
// (night), so keyboard focus never moves; the inactive body sets below the
// horizon. It cycles System, then Night, then Daylight; WebsiteLayout wires it up.
import { css, cx } from "../../styled-system/css";

interface Props {
	// inline: in a header row; corner: pinned to the top right of a positioned page.
	placement: "inline" | "corner";
}

const placements = {
	inline: css({ position: "relative", width: "44px" }),
	corner: css({
		position: "absolute",
		top: { base: "8%", _narrow: "4" },
		right: { base: "10%", _narrow: "4" },
		width: "clamp(3.5rem, 6vw, 5.5rem)",
	}),
};

const toggle = css({
	flex: "none",
	aspectRatio: "1",
	p: 0,
	border: 0,
	bg: "transparent",
	cursor: "pointer",
	borderRadius: "pill",
	_motionSafe: { transition: "scale {durations.base} {easings.out}" },
	_hover: { scale: "1.08" },
	_active: { scale: "0.94" },
	_focusVisible: { outline: "3px solid {colors.focus}", outlineOffset: "6px" },
});
const body = css({
	position: "absolute",
	inset: 0,
	_motionSafe: {
		transition: "opacity {durations.slower} {easings.out}, transform {durations.slower} {easings.out}",
	},
});
const set = { opacity: 0, pointerEvents: "none" } as const;
const risen = { opacity: 1, transform: "none" } as const;
const sun = css({
	color: "beak.300",
	...set,
	transform: "translate(140px, 420px) rotate(55deg) scale(0.7)",
	_daylight: risen,
});
const moon = css({
	color: "ice.100",
	_daylight: { ...set, transform: "translate(-140px, 420px) rotate(-55deg) scale(0.7)" },
});
const spin = css({ display: "block", width: "100%", height: "100%", _motionSafe: { animation: "spin 40s linear infinite" } });
const bob = css({ display: "block", width: "100%", height: "100%", _motionSafe: { animation: "moonBob 9s ease-in-out infinite" } });
// The System choice: a small "A" (auto) badge on the corner of the sun or moon.
const auto = css({
	position: "absolute",
	right: "-6%",
	bottom: "-6%",
	display: "none",
	alignItems: "center",
	justifyContent: "center",
	width: "42%",
	aspectRatio: "1",
	borderRadius: "pill",
	bg: "surface",
	color: "fg",
	border: "1px solid {colors.border}",
	fontFamily: "mono",
	fontSize: "clamp(0.625rem, 1.1vw, 0.875rem)",
	fontWeight: "bold",
	lineHeight: 1,
	"[data-choice=system] > &": { display: "flex" },
});
---

<button
	type="button"
	class={cx(toggle, placements[Astro.props.placement])}
	data-theme-toggle
	aria-label="Theme"
>
	<span class={cx(body, sun)}
		><svg class={spin} viewBox="0 0 100 100" aria-hidden="true">
			<circle cx="50" cy="50" r="18" fill="currentColor"></circle>
			<g stroke="currentColor" stroke-width="3" stroke-linecap="round">
				<line x1="50" y1="8" x2="50" y2="22"></line><line x1="50" y1="78" x2="50" y2="92"></line>
				<line x1="8" y1="50" x2="22" y2="50"></line><line x1="78" y1="50" x2="92" y2="50"></line>
				<line x1="20" y1="20" x2="30" y2="30"></line><line x1="70" y1="70" x2="80" y2="80"></line>
				<line x1="80" y1="20" x2="70" y2="30"></line><line x1="30" y1="70" x2="20" y2="80"></line>
			</g>
		</svg></span
	>
	<span class={cx(body, moon)}
		><svg class={bob} viewBox="0 0 100 100" aria-hidden="true">
			<path d="M60 8 A42 42 0 1 0 92 56 A32 32 0 0 1 60 8 Z" fill="currentColor"></path>
			<circle cx="62" cy="38" r="3" fill="var(--colors-ice-300)" opacity="0.7"></circle>
			<circle cx="74" cy="58" r="4" fill="var(--colors-ice-300)" opacity="0.6"></circle>
			<circle cx="52" cy="62" r="2.5" fill="var(--colors-ice-300)" opacity="0.5"></circle>
		</svg></span
	>
	<span class={auto} aria-hidden="true">A</span>
</button>
