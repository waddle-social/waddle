using Gtk 4.0;
using Adw 1;

template $WaddleWindow: Adw.ApplicationWindow {
  title: _("Waddle");
  default-width: 1100;
  default-height: 720;
  width-request: 360;
  height-request: 294;

  Adw.Breakpoint {
    condition ("max-width: 640sp")

    setters {
      split_view.collapsed: true;
    }
  }

  content: Adw.ToastOverlay toast_overlay {
    child: Stack stack {
      transition-type: crossfade;

      StackPage {
        name: "loading";

        child: Adw.ToolbarView {
          [top]
          Adw.HeaderBar {}

          content: Adw.Spinner {};
        };
      }

      StackPage {
        name: "server";

        child: Adw.ToolbarView {
          [top]
          Adw.HeaderBar {}

          content: Adw.StatusPage {
            icon-name: "system-users-symbolic";
            title: _("Sign in to Waddle");
            description: _("Enter the address of your community's server.");

            child: Adw.Clamp {
              maximum-size: 420;

              child: Box {
                orientation: vertical;
                spacing: 24;

                ListBox {
                  selection-mode: none;

                  styles [
                    "boxed-list",
                  ]

                  Adw.EntryRow server_entry {
                    title: _("Server");
                    text: "xmpp.waddle.social";
                    input-purpose: url;
                    activates-default: true;
                    entry-activated => $on_server_continue() swapped;
                  }
                }

                Button server_continue {
                  label: _("Continue");
                  halign: center;
                  clicked => $on_server_continue() swapped;

                  styles [
                    "pill",
                    "suggested-action",
                  ]
                }
              };
            };
          };
        };
      }

      StackPage {
        name: "providers";

        child: Adw.ToolbarView {
          [top]
          Adw.HeaderBar {
            [start]
            Button {
              icon-name: "go-previous-symbolic";
              tooltip-text: _("Back");
              clicked => $on_back_to_server() swapped;
            }
          }

          content: Adw.StatusPage providers_status {
            title: _("Choose how to sign in");

            child: Adw.Clamp {
              maximum-size: 420;

              child: ListBox provider_list {
                selection-mode: none;
                row-activated => $on_provider_activated() swapped;

                styles [
                  "boxed-list",
                ]
              };
            };
          };
        };
      }

      StackPage {
        name: "code";

        child: Adw.ToolbarView {
          [top]
          Adw.HeaderBar {
            [start]
            Button {
              icon-name: "go-previous-symbolic";
              tooltip-text: _("Cancel");
              clicked => $on_back_to_server() swapped;
            }
          }

          content: Adw.StatusPage {
            title: _("Approve this device");
            description: _("Your browser opened the sign-in page. If it asks for a code, enter this one. This window continues by itself once you approve.");

            child: Box {
              orientation: vertical;
              spacing: 24;
              halign: center;

              Label user_code_label {
                selectable: true;

                styles [
                  "title-1",
                  "monospace",
                ]
              }

              Button {
                label: _("Open the Sign-in Page Again");
                halign: center;
                clicked => $on_open_verification() swapped;

                styles [
                  "pill",
                ]
              }

              Adw.Spinner {
                height-request: 32;
              }
            };
          };
        };
      }

      StackPage {
        name: "shell";

        child: Adw.NavigationSplitView split_view {
          sidebar: Adw.NavigationPage {
            title: _("Waddle");

            child: Adw.ToolbarView {
              [top]
              Adw.HeaderBar {
                [end]
                MenuButton {
                  icon-name: "open-menu-symbolic";
                  tooltip-text: _("Main Menu");
                  menu-model: primary_menu;
                  primary: true;
                }
              }

              content: ScrolledWindow {
                hscrollbar-policy: never;

                child: ListBox sidebar_list {
                  styles [
                    "navigation-sidebar",
                  ]

                  Adw.ActionRow {
                    title: _("Home");
                    activatable: true;
                  }

                  Adw.ActionRow {
                    title: _("Rooms");
                    activatable: true;
                  }

                  Adw.ActionRow {
                    title: _("People");
                    activatable: true;
                  }

                  Adw.ActionRow {
                    title: _("Direct Messages");
                    activatable: true;
                  }

                  Adw.ActionRow {
                    title: _("You");
                    activatable: true;
                  }
                };
              };
            };
          };

          content: Adw.NavigationPage {
            title: _("Home");

            child: Adw.ToolbarView {
              [top]
              Adw.HeaderBar {}

              content: Adw.StatusPage account_status {
                icon-name: "user-available-symbolic";
                description: _("Rooms, direct messages and calls arrive with the shared client core.");
              };
            };
          };
        };
      }
    };
  };
}

menu primary_menu {
  section {
    item {
      label: _("Sign Out");
      action: "win.sign-out";
    }

    item {
      label: _("About Waddle");
      action: "app.about";
    }
  }
}
