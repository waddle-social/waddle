# Xcode build output
.derivedData/
.derived/
.build/

# Xcode user state
*.xcuserstate
xcuserdata/

# Rust XCFramework build artifacts (regenerated by scripts/build-xcframework.sh)
# Only the top-level Generated/ (XCFramework binaries) is excluded;
# Waddle/RustClient/Generated/ (Swift sources) is tracked.
/Generated/

# Apple brand assets are generated from chat/public/waddle-logo.svg
/Waddle/Assets.xcassets/AppIcon.appiconset/*.png
/Waddle/Assets.xcassets/WaddleLogo.imageset/waddle-logo.svg
