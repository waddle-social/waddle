<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ twin of allowBackup="false": session tokens and message
     snapshots must never leave the device via backup or transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
